<!DOCTYPE html>
<html>
  <head>
    <title>MyFinance</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="<%= asset_path('logo.svg') %>">
    <link rel="alternate icon" href="<%= asset_path('logo.svg') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (() => {
        let storedTheme = null
        try {
          storedTheme = localStorage.getItem("myfinance-theme")
        } catch (_) {}
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
        const theme = storedTheme || (prefersDark ? "dark" : "light")
        if (theme === "dark") {
          document.documentElement.classList.add("dark")
          document.addEventListener("DOMContentLoaded", () => {
            if (document.body) document.body.classList.add("dark")
          })
        }
      })();
    </script>

    <!-- Tom Select (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet" />
    <!-- Flatpickr (CDN) for datepicker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/style.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.5/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pt.js"></script>
    <style>
      .badge-income { background-color: #ecfdf3; color: #047857; border: 1px solid #bbf7d0; }
      .badge-expense { background-color: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }
      .dark .badge-income { background-color: #064e3b; color: #d1fae5; border: 1px solid #065f46; }
      .dark .badge-expense { background-color: #7c2d12; color: #ffedd5; border: 1px solid #9a3412; }
    </style>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-900 dark:bg-slate-950 dark:text-slate-100">
    <% auth_page = controller_name == "sessions" && %w[new create].include?(action_name) %>

    <% if auth_page %>
      <main class="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8">
        <div class="w-full flex justify-center">
          <%= yield %>
        </div>
      </main>
    <% else %>
      <div class="flex-1 flex" data-controller="mobile-menu">
        <aside data-mobile-menu-target="panel" class="hidden fixed inset-y-0 left-0 z-40 w-72 flex-col border-r border-slate-200 bg-white p-4 shadow-xl dark:border-slate-800 dark:bg-slate-900 lg:static lg:z-0 lg:flex lg:shadow-none">
          <%= link_to root_path, class: "mb-6 flex items-center gap-2" do %>
            <%= image_tag "logo.svg", class: "h-10 w-10 shrink-0", alt: "MyFinance logo" %>
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400">Painel financeiro</p>
              <p class="text-lg font-semibold text-slate-900 dark:text-slate-100">MyFinance</p>
            </div>
          <% end %>

          <div class="mb-5 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <%= l(Date.current, format: "%d de %b. de %Y") %>
          </div>

          <% side_link_classes = "inline-flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-100 hover:text-emerald-700 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-emerald-400" %>
          <% side_danger_link_classes = "inline-flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm text-red-600 transition hover:bg-red-50 hover:text-red-700 dark:text-red-300 dark:hover:bg-red-950/50 dark:hover:text-red-200 bg-transparent cursor-pointer" %>
          <nav class="space-y-1">
            <% if current_user %>
              <%= link_to dashboard_path, class: side_link_classes do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="4" rx="1.5"/><rect x="13.5" y="11.5" width="7" height="9" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/></svg>
                <span>Dashboard</span>
              <% end %>
              <%= link_to transactions_path, class: side_link_classes do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3.5" width="16" height="17" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>
                <span>Transações</span>
              <% end %>
              <%= link_to categories_path, class: side_link_classes do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="7.5" r="1.5"/><circle cx="16.5" cy="7.5" r="1.5"/><circle cx="7.5" cy="16.5" r="1.5"/><circle cx="16.5" cy="16.5" r="1.5"/><line x1="9" y1="7.5" x2="15" y2="7.5"/><line x1="9" y1="16.5" x2="15" y2="16.5"/><line x1="7.5" y1="9" x2="7.5" y2="15"/><line x1="16.5" y1="9" x2="16.5" y2="15"/></svg>
                <span>Categorias</span>
              <% end %>
              <%= link_to account_path, class: side_link_classes do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.25"/><path d="M5 19.25c0-3.15 3.1-5.25 7-5.25s7 2.1 7 5.25"/></svg>
                <span>Minha conta</span>
              <% end %>
            <% else %>
              <%= link_to new_session_path, class: side_link_classes do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4.5h8a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H9"/><line x1="13.5" y1="12" x2="4.5" y2="12"/><polyline points="8.5 8.5 4.5 12 8.5 15.5"/></svg>
                <span>Entrar</span>
              <% end %>
              <%= link_to new_user_path, class: side_link_classes do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="8" r="3.25"/><path d="M3.5 19c0-2.9 2.8-4.75 6.5-4.75s6.5 1.85 6.5 4.75"/><line x1="19" y1="9.5" x2="19" y2="16.5"/><line x1="15.5" y1="13" x2="22.5" y2="13"/></svg>
                <span>Criar conta</span>
              <% end %>
            <% end %>
          </nav>

          <div class="mt-auto pt-5">
            <button type="button"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 hover:border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                    data-controller="theme"
                    data-action="click->theme#toggle"
                    data-theme-target="button"
                    aria-label="Alternar tema">
              <svg data-theme-target="iconMoon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M21.752 15.002A9.718 9.718 0 0 1 12 21.75 9.75 9.75 0 0 1 8.998 2.25a.75.75 0 0 1 .743 1.125A8.25 8.25 0 0 0 20.625 14.26a.75.75 0 0 1 1.127.742Z" /></svg>
              <svg data-theme-target="iconSun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden h-4 w-4"><path d="M12 6.75a5.25 5.25 0 1 0 0 10.5 5.25 5.25 0 0 0 0-10.5Zm0-4.5a.75.75 0 0 1 .75.75V4.5a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75Zm0 16.5a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75ZM4.5 12a.75.75 0 0 1 .75-.75H6.75a.75.75 0 0 1 0 1.5H5.25A.75.75 0 0 1 4.5 12Zm12 0a.75.75 0 0 1 .75-.75H18.75a.75.75 0 0 1 0 1.5H17.25A.75.75 0 0 1 16.5 12ZM6.22 6.22a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 0 1-1.06 1.06L6.22 7.28a.75.75 0 0 1 0-1.06Zm9.44 9.44a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 0 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.06ZM6.22 17.78a.75.75 0 0 1 0-1.06l1.06-1.06a.75.75 0 0 1 1.06 1.06l-1.06 1.06a.75.75 0 0 1-1.06 0Zm9.44-9.44a.75.75 0 0 1 0-1.06l1.06-1.06a.75.75 0 1 1 1.06 1.06l-1.06 1.06a.75.75 0 0 1-1.06 0Z" /></svg>
              <span data-theme-target="label">Modo claro</span>
            </button>
            <% if current_user %>
              <%= button_to session_path, method: :delete, form: { class: "mt-2 w-full" }, class: side_danger_link_classes do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M7.5 3.75A2.25 2.25 0 0 0 5.25 6v12a2.25 2.25 0 0 0 2.25 2.25H15A2.25 2.25 0 0 0 17.25 18v-1.5a.75.75 0 0 0-1.5 0V18a.75.75 0 0 1-.75.75H7.5A.75.75 0 0 1 6.75 18V6a.75.75 0 0 1 .75-.75H15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 0 1.5 0V6A2.25 2.25 0 0 0 15 3.75H7.5Zm9.22 4.72a.75.75 0 0 0-1.06 1.06l1.47 1.47H10.5a.75.75 0 0 0 0 1.5h6.63l-1.47 1.47a.75.75 0 0 0 1.06 1.06l2.75-2.75a.75.75 0 0 0 0-1.06l-2.75-2.75Z" clip-rule="evenodd"/></svg>
                <span>Sair</span>
              <% end %>
            <% end %>
          </div>
        </aside>

        <div class="flex-1 min-w-0">
          <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 px-4 py-3 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/95 sm:px-6">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
              <div class="flex items-center justify-between gap-3 lg:min-w-64">
                <%= link_to root_path, class: "flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100 lg:hidden" do %>
                  <%= image_tag "logo.svg", class: "h-8 w-8 shrink-0", alt: "MyFinance logo" %>
                  <span>MyFinance</span>
                <% end %>
                <div class="hidden min-w-0 lg:block">
                  <p class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Busca global</p>
                  <p class="truncate text-sm text-slate-700 dark:text-slate-300">Consulte seus dados financeiros em toda a aplicação.</p>
                </div>
                <button type="button"
                        class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white p-2 text-slate-700 hover:bg-slate-50 hover:border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 lg:hidden"
                        aria-label="Abrir menu"
                        data-action="click->mobile-menu#toggle">
                  <svg data-mobile-menu-target="iconOpen" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M3.75 6.75A.75.75 0 0 1 4.5 6h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0 10.5A.75.75 0 0 1 4.5 16.5h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0-5.25a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                  </svg>
                  <svg data-mobile-menu-target="iconClose" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 hidden">
                    <path fill-rule="evenodd" d="M6.47 6.47a.75.75 0 0 1 1.06 0L12 10.94l4.47-4.47a.75.75 0 1 1 1.06 1.06L13.06 12l4.47 4.47a.75.75 0 0 1-1.06 1.06L12 13.06l-4.47 4.47a.75.75 0 0 1-1.06-1.06L10.94 12 6.47 7.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </button>
              </div>
              <% if current_user %>
                <div class="w-full lg:max-w-2xl">
                  <%= render "shared/global_search_form" %>
                </div>
              <% end %>
            </div>
          </header>

          <div id="flash_toasts">
            <%= render "shared/toasts" %>
          </div>

          <main class="w-full px-4 py-6 sm:px-6 lg:px-8">
            <%= yield %>
          </main>
        </div>
      </div>
    <% end %>

    <% unless auth_page %>
      <footer class="border-t border-slate-200 bg-white px-4 py-8 text-center text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 sm:py-10">
        <div class="w-full flex min-h-16 flex-col items-center justify-center gap-2">
          <p>Developed by: Sérgio Nascimento © Todos os direitos reservados.</p>
        </div>
      </footer>
    <% end %>
    <div data-controller="modal" data-modal-open-class="is-open">
      <div data-modal-target="backdrop" class="fixed inset-0 z-40 bg-slate-900/60 backdrop-blur-sm hidden" data-action="click->modal#close"></div>
      <div data-modal-target="container" class="fixed inset-0 z-50 grid place-items-center px-4 py-8 pointer-events-none hidden">
        <div class="relative w-full max-w-3xl pointer-events-auto overflow-visible rounded-2xl bg-white shadow-2xl border border-slate-200 dark:bg-slate-900 dark:border-slate-700" data-modal-target="panel">
          <button type="button" class="absolute right-3 top-3 rounded-full bg-slate-100 p-2 text-slate-500 hover:bg-slate-200 focus:outline focus:outline-2 focus:outline-blue-400 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" aria-label="Fechar" data-action="modal#close">X</button>
          <turbo-frame id="modal" data-modal-target="frame" data-action="turbo:frame-load->modal#open turbo:submit-end->modal#handleSubmit">
            <!-- Conteúdo carregado dinamicamente -->
          </turbo-frame>
        </div>
      </div>
    </div>
  </body>
</html>
