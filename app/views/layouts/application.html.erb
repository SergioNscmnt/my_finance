<!DOCTYPE html>
<html>
  <head>
    <title>MyFinance</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="<%= asset_path('logo.svg') %>">
    <link rel="alternate icon" href="<%= asset_path('logo.svg') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.5/dist/chart.umd.min.js"></script>
    <!-- Tom Select (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <!-- Flatpickr (CDN) for datepicker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pt.js"></script>
    <style>
      .badge-income { background-color: #ecfdf3; color: #047857; border: 1px solid #bbf7d0; }
      .badge-expense { background-color: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }
    </style>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <% auth_page = controller_name == "sessions" && action_name == "new" %>

    <% if auth_page %>
      <main class="min-h-screen flex items-center justify-center px-4 py-10">
        <div class="w-full max-w-5xl">
          <% flash.each do |type, message| %>
            <div class="mb-4 rounded border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800"><%= message %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    <% else %>
      <div class="min-h-screen">
        <nav class="bg-white shadow-sm" data-controller="mobile-menu">
          <div class="max-w-5xl mx-auto px-4 py-4">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
              <div class="flex items-center justify-between">
                <%= link_to root_path, class: "flex items-center gap-1.5 font-semibold text-lg leading-none text-gray-900" do %>
                  <%= image_tag "logo.svg", class: "h-12 w-12 shrink-0 align-middle", alt: "MyFinance logo" %>
                  <span class="leading-none">MyFinance</span>
                <% end %>
                <button type="button"
                        class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white p-2 text-slate-700 hover:bg-slate-50 hover:border-slate-300 lg:hidden"
                        aria-label="Abrir menu"
                        data-action="click->mobile-menu#toggle">
                  <svg data-mobile-menu-target="iconOpen" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M3.75 6.75A.75.75 0 0 1 4.5 6h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0 10.5A.75.75 0 0 1 4.5 16.5h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0-5.25a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                  </svg>
                  <svg data-mobile-menu-target="iconClose" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 hidden">
                    <path fill-rule="evenodd" d="M6.47 6.47a.75.75 0 0 1 1.06 0L12 10.94l4.47-4.47a.75.75 0 1 1 1.06 1.06L13.06 12l4.47 4.47a.75.75 0 0 1-1.06 1.06L12 13.06l-4.47 4.47a.75.75 0 0 1-1.06-1.06L10.94 12 6.47 7.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </button>
              </div>

              <div class="hidden w-full flex-col items-start gap-3 lg:flex lg:flex-row lg:items-center lg:gap-4 lg:w-auto"
                   data-mobile-menu-target="panel">
                <% if current_user %>
                  <span class="text-sm text-slate-600 border-b-2 border-transparent pb-1">Olá, <span class="font-semibold text-slate-900"><%= current_user.name %></span></span>
                  <%= link_to "Dashboard", dashboard_path, class: "text-sm text-gray-700 hover:text-emerald-700 border-b-2 border-transparent hover:border-emerald-500 pb-1 transition-colors w-full lg:w-auto" %>
                  <%= link_to "Transações", transactions_path, class: "text-sm text-gray-700 hover:text-emerald-700 border-b-2 border-transparent hover:border-emerald-500 pb-1 transition-colors w-full lg:w-auto" %>
                  <%= link_to "Categorias", categories_path, class: "text-sm text-gray-700 hover:text-emerald-700 border-b-2 border-transparent hover:border-emerald-500 pb-1 transition-colors w-full lg:w-auto" %>
                  <%= link_to "Minha conta", account_path, class: "text-sm text-gray-700 hover:text-emerald-700 border-b-2 border-transparent hover:border-emerald-500 pb-1 transition-colors w-full lg:w-auto" %>
                  <%= link_to "Sair", session_path, data: { turbo_method: :delete }, class: "text-sm text-red-600 hover:text-red-700 border-b-2 border-transparent hover:border-red-500 pb-1 transition-colors w-full lg:w-auto" %>
                <% else %>
                  <%= link_to "Entrar", new_session_path, class: "text-sm text-gray-700 hover:text-emerald-700 border-b-2 border-transparent hover:border-emerald-500 pb-1 transition-colors w-full lg:w-auto" %>
                  <%= link_to "Criar conta", new_user_path, class: "text-sm text-gray-700 hover:text-emerald-700 border-b-2 border-transparent hover:border-emerald-500 pb-1 transition-colors w-full lg:w-auto" %>
                <% end %>
              </div>
            </div>
          </div>
        </nav>

        <main class="max-w-5xl mx-auto px-4 py-6">
          <% flash.each do |type, message| %>
            <div class="mb-4 rounded border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800"><%= message %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    <% end %>

    <!-- Modal global controlado por Stimulus + Turbo Frame -->
    <div data-controller="modal" data-modal-open-class="is-open">
      <div data-modal-target="backdrop" class="fixed inset-0 z-40 bg-slate-900/60 backdrop-blur-sm hidden" data-action="click->modal#close"></div>
      <div data-modal-target="container" class="fixed inset-0 z-50 grid place-items-center px-4 py-8 pointer-events-none hidden">
        <div class="relative w-full max-w-3xl pointer-events-auto overflow-visible rounded-2xl bg-white shadow-2xl border border-slate-200" data-modal-target="panel">
          <button type="button" class="absolute right-3 top-3 rounded-full bg-slate-100 p-2 text-slate-500 hover:bg-slate-200 focus:outline focus:outline-2 focus:outline-blue-400" aria-label="Fechar" data-action="modal#close">X</button>
          <turbo-frame id="modal" data-modal-target="frame" data-action="turbo:frame-load->modal#open turbo:submit-end->modal#handleSubmit">
            <!-- Conteúdo carregado dinamicamente -->
          </turbo-frame>
        </div>
      </div>
    </div>

    <!-- Tom Select inicializa via Stimulus (controllers/tom_select_controller.js) -->
  </body>
</html>
