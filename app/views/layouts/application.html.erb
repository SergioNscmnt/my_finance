<!DOCTYPE html>
<html>
  <head>
    <title>MyFinance</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="<%= asset_path('logo.svg') %>">
    <link rel="alternate icon" href="<%= asset_path('logo.svg') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (() => {
        let storedTheme = null
        try {
          storedTheme = localStorage.getItem("myfinance-theme")
        } catch (_) {}
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
        const theme = storedTheme || (prefersDark ? "dark" : "light")
        if (theme === "dark") {
          document.documentElement.classList.add("dark")
          document.addEventListener("DOMContentLoaded", () => {
            if (document.body) document.body.classList.add("dark")
          })
        }
      })();
    </script>

    <!-- Tom Select (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet" />
    <!-- Flatpickr (CDN) for datepicker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.5/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pt.js"></script>
    <style>
      .badge-income { background-color: #ecfdf3; color: #047857; border: 1px solid #bbf7d0; }
      .badge-expense { background-color: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }
      .dark .badge-income { background-color: #064e3b; color: #d1fae5; border: 1px solid #065f46; }
      .dark .badge-expense { background-color: #7c2d12; color: #ffedd5; border: 1px solid #9a3412; }
    </style>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-900 dark:bg-slate-950 dark:text-slate-100">
    <% auth_page = controller_name == "sessions" && action_name == "new" %>

    <% if auth_page %>
      <main class="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8">
        <div class="w-full flex justify-center">
          <%= yield %>
        </div>
      </main>
    <% else %>
      <div class="flex-1">
        <nav class="bg-white shadow-sm dark:bg-slate-900 dark:border-b dark:border-slate-800" data-controller="mobile-menu">
          <div class="w-full px-4 py-4 sm:px-6 lg:px-8">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
              <div class="flex items-center justify-between">
                <%= link_to root_path, class: "flex items-center gap-1.5 font-semibold text-lg leading-none text-gray-900 dark:text-slate-100" do %>
                  <%= image_tag "logo.svg", class: "h-12 w-12 shrink-0 align-middle", alt: "MyFinance logo" %>
                  <span class="leading-none">MyFinance</span>
                <% end %>
                <button type="button"
                        class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white p-2 text-slate-700 hover:bg-slate-50 hover:border-slate-300 lg:hidden dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                        aria-label="Abrir menu"
                        data-action="click->mobile-menu#toggle">
                  <svg data-mobile-menu-target="iconOpen" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path fill-rule="evenodd" d="M3.75 6.75A.75.75 0 0 1 4.5 6h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0 10.5A.75.75 0 0 1 4.5 16.5h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0-5.25a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                  </svg>
                  <svg data-mobile-menu-target="iconClose" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 hidden">
                    <path fill-rule="evenodd" d="M6.47 6.47a.75.75 0 0 1 1.06 0L12 10.94l4.47-4.47a.75.75 0 1 1 1.06 1.06L13.06 12l4.47 4.47a.75.75 0 0 1-1.06 1.06L12 13.06l-4.47 4.47a.75.75 0 0 1-1.06-1.06L10.94 12 6.47 7.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </button>
              </div>

              <% nav_link_classes = "inline-flex h-8 w-full items-center text-sm text-gray-700 dark:text-slate-200 hover:text-emerald-700 dark:hover:text-emerald-400 border-b-2 border-transparent hover:border-emerald-500 transition-colors lg:w-auto" %>
              <% nav_danger_link_classes = "inline-flex h-8 w-full items-center text-sm text-red-600 dark:text-red-300 hover:text-red-700 dark:hover:text-red-200 border-b-2 border-transparent hover:border-red-500 transition-colors lg:w-auto bg-transparent p-0 cursor-pointer" %>
              <div class="hidden w-full flex-col items-stretch gap-3 lg:flex lg:flex-row lg:items-center lg:gap-4 lg:w-auto"
                   data-mobile-menu-target="panel">
                <div class="grid w-full grid-cols-2 gap-2 lg:w-auto lg:flex lg:items-center lg:gap-2">
                  <span class="inline-flex h-8 w-full items-center justify-center whitespace-nowrap rounded-full border border-slate-200 bg-slate-50 px-1.5 text-[10px] font-medium text-slate-700 sm:px-3 sm:text-xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                    <%= l(Date.current, format: "%d de %b. de %Y") %>
                  </span>
                  <button type="button"
                          class="inline-flex w-full items-center justify-center gap-1 rounded-full border border-slate-200 bg-white px-2 py-1 text-[11px] font-semibold text-slate-700 transition hover:bg-slate-50 hover:border-slate-300 sm:gap-2 sm:px-3 sm:py-1.5 sm:text-xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
                          data-controller="theme"
                          data-action="click->theme#toggle"
                          data-theme-target="button"
                          aria-label="Alternar tema">
                    <svg data-theme-target="iconMoon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3 sm:h-4 sm:w-4">
                      <path d="M21.752 15.002A9.718 9.718 0 0 1 12 21.75 9.75 9.75 0 0 1 8.998 2.25a.75.75 0 0 1 .743 1.125A8.25 8.25 0 0 0 20.625 14.26a.75.75 0 0 1 1.127.742Z" />
                    </svg>
                    <svg data-theme-target="iconSun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden h-3 w-3 sm:h-4 sm:w-4">
                      <path d="M12 6.75a5.25 5.25 0 1 0 0 10.5 5.25 5.25 0 0 0 0-10.5Zm0-4.5a.75.75 0 0 1 .75.75V4.5a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75Zm0 16.5a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75ZM4.5 12a.75.75 0 0 1 .75-.75H6.75a.75.75 0 0 1 0 1.5H5.25A.75.75 0 0 1 4.5 12Zm12 0a.75.75 0 0 1 .75-.75H18.75a.75.75 0 0 1 0 1.5H17.25A.75.75 0 0 1 16.5 12ZM6.22 6.22a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 0 1-1.06 1.06L6.22 7.28a.75.75 0 0 1 0-1.06Zm9.44 9.44a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 0 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.06ZM6.22 17.78a.75.75 0 0 1 0-1.06l1.06-1.06a.75.75 0 0 1 1.06 1.06l-1.06 1.06a.75.75 0 0 1-1.06 0Zm9.44-9.44a.75.75 0 0 1 0-1.06l1.06-1.06a.75.75 0 1 1 1.06 1.06l-1.06 1.06a.75.75 0 0 1-1.06 0Z" />
                    </svg>
                    <span data-theme-target="label">Modo claro</span>
                  </button>
                </div>
                <% if current_user %>
                  <%= link_to "Dashboard", dashboard_path, class: nav_link_classes %>
                  <%= link_to "Investimentos", investments_portfolio_path, class: nav_link_classes %>
                  <%= link_to "Transações", transactions_path, class: nav_link_classes %>
                  <%= link_to "Categorias", categories_path, class: nav_link_classes %>
                  <%= link_to "Minha conta", account_path, class: nav_link_classes %>
                  <%= button_to "Sair",
                                session_path,
                                method: :delete,
                                form: { class: "w-full lg:w-auto lg:flex lg:items-center" },
                                class: nav_danger_link_classes %>
                <% else %>
                  <%= link_to "Entrar", new_session_path, class: nav_link_classes %>
                  <%= link_to "Criar conta", new_user_path, class: nav_link_classes %>
                <% end %>
              </div>
            </div>
          </div>
        </nav>

        <div id="flash_toasts">
          <%= render "shared/toasts" %>
        </div>

        <main class="w-full px-4 py-6 sm:px-6 lg:px-8">
          <%= yield %>
        </main>
      </div>
    <% end %>

    <footer class="border-t border-slate-200 bg-white px-4 py-4 text-center text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
      <div class="w-full flex flex-col items-center gap-1">
        <p>Developed by: Sérgio Nascimento © Todos os direitos reservados.</p>
      </div>
    </footer>

    <!-- Modal global controlado por Stimulus + Turbo Frame -->
    <div data-controller="modal" data-modal-open-class="is-open">
      <div data-modal-target="backdrop" class="fixed inset-0 z-40 bg-slate-900/60 backdrop-blur-sm hidden" data-action="click->modal#close"></div>
      <div data-modal-target="container" class="fixed inset-0 z-50 grid place-items-center px-4 py-8 pointer-events-none hidden">
        <div class="relative w-full max-w-3xl pointer-events-auto overflow-visible rounded-2xl bg-white shadow-2xl border border-slate-200 dark:bg-slate-900 dark:border-slate-700" data-modal-target="panel">
          <button type="button" class="absolute right-3 top-3 rounded-full bg-slate-100 p-2 text-slate-500 hover:bg-slate-200 focus:outline focus:outline-2 focus:outline-blue-400 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" aria-label="Fechar" data-action="modal#close">X</button>
          <turbo-frame id="modal" data-modal-target="frame" data-action="turbo:frame-load->modal#open turbo:submit-end->modal#handleSubmit">
            <!-- Conteúdo carregado dinamicamente -->
          </turbo-frame>
        </div>
      </div>
    </div>

    <!-- Tom Select inicializa via Stimulus (controllers/tom_select_controller.js) -->
  </body>
</html>
