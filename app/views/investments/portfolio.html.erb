<div class="space-y-6">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Investimentos</p>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Carteira</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">Visão consolidada das posições, alocação por classe e evolução do patrimônio.</p>
  </div>

  <%= render "subnav" %>

  <% asset_class_labels = { "Stock" => "Ações", "Fii" => "FIIs", "Fixed income" => "Renda fixa", "Crypto" => "Criptoativos", "Fund" => "Fundos" } %>
  <div class="grid gap-4 lg:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Patrimônio total</p>
      <p class="mt-2 text-2xl font-semibold text-slate-900 dark:text-slate-100">
        <%= number_to_currency(@performance[:invested_total]) %>
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Valor investido consolidado na carteira.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Alocação por classe</p>
      <div class="mt-3 space-y-1 text-xs text-slate-600 dark:text-slate-300">
        <% @allocation.each do |kind, share| %>
          <div class="flex items-center justify-between">
            <span class="capitalize"><%= asset_class_labels.fetch(kind.to_s.humanize, kind.to_s.humanize) %></span>
            <span><%= number_to_percentage(share * 100, precision: 1) %></span>
          </div>
        <% end %>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Rentabilidade</p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">
        Resultado total:
        <span class="<%= @performance[:total_result].to_d.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %>">
          <%= number_to_currency(@performance[:total_result]) %>
        </span>
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
        Proventos: <%= number_to_currency(@performance[:dividends_total]) %> ·
        Lucro realizado:
        <span class="<%= @performance[:realized_profit].to_d.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %>">
          <%= number_to_currency(@performance[:realized_profit]) %>
        </span>
      </p>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Posições</h2>
      <span class="text-xs text-slate-500 dark:text-slate-400"><%= @positions.size %> ativos</span>
    </div>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-xs text-slate-600 dark:text-slate-300">
        <thead class="uppercase tracking-wide text-slate-400">
          <tr>
            <th class="py-2 pr-4">Ativo</th>
            <th class="py-2 pr-4">Quantidade</th>
            <th class="py-2 pr-4">Preço médio</th>
            <th class="py-2 pr-4">Investido</th>
            <th class="py-2">Lucro realizado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @positions.empty? %>
            <tr>
              <td colspan="5" class="py-4 text-sm text-slate-500 dark:text-slate-400">
                Nenhuma posição cadastrada ainda.
              </td>
            </tr>
          <% else %>
            <% @positions.each do |position| %>
              <tr>
                <td class="py-2 pr-4">
                  <div class="font-semibold text-slate-900 dark:text-slate-100"><%= position.asset.ticker %></div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400"><%= position.asset.name %></div>
                </td>
                <td class="py-2 pr-4"><%= position.quantity %></td>
                <td class="py-2 pr-4"><%= number_to_currency(position.avg_price) %></td>
                <td class="py-2 pr-4"><%= number_to_currency(position.invested_amount) %></td>
                <td class="py-2">
                  <span class="<%= position.realized_profit.to_d.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %>">
                    <%= number_to_currency(position.realized_profit) %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
