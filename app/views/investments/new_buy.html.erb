<%= turbo_frame_tag "modal" do %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 pr-14 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Comprar ativo</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">Selecione ação, fundo ou cripto do catálogo Massive.</p>
      </div>
      <%= link_to "Atualizar catálogo",
                  investments_sync_instruments_path,
                  data: { turbo_method: :post, turbo_confirm: "Atualizar catálogo da Massive agora?" },
                  class: "rounded-md border border-emerald-200 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-50 dark:border-emerald-900 dark:text-emerald-300 dark:hover:bg-emerald-900/20" %>
    </div>

    <% if flash.now[:alert].present? %>
      <div class="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-900/30 dark:text-red-200">
        <%= flash.now[:alert] %>
      </div>
    <% end %>

    <%= form_with url: new_investments_buy_path, method: :get, data: { turbo_frame: "modal" }, class: "mb-4 grid gap-3 md:grid-cols-[1fr_auto]" do |f| %>
      <div class="space-y-1">
        <label class="text-sm font-medium text-slate-700 dark:text-slate-200">Ativo</label>
        <select name="instrument_id"
                class="tom-select w-full"
                data-controller="tom-select"
                data-placeholder="Digite ticker ou nome"
                data-remote-url="<%= investments_instruments_search_path %>">
          <option value=""></option>
          <% if @selected_instrument %>
            <option value="<%= @selected_instrument.id %>" selected>
              <%= "#{@selected_instrument.ticker} - #{@selected_instrument.name} (#{@selected_instrument.asset_type})" %>
            </option>
          <% end %>
        </select>
      </div>
      <div class="self-end">
        <%= f.submit "Analisar", class: "w-full rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 md:w-auto" %>
      </div>
    <% end %>

    <% if !@catalog_available %>
      <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/50 dark:bg-amber-900/20 dark:text-amber-200">
        Catálogo vazio. Use "Atualizar catálogo" para importar ações, fundos e criptos da Massive.
      </div>
    <% elsif @selected_instrument && @snapshot.present? %>
      <div class="mb-4 grid gap-4 rounded-xl border border-slate-200 p-4 dark:border-slate-700 md:grid-cols-3">
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Ativo</p>
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100"><%= @selected_instrument.ticker %> · <%= @selected_instrument.name %></p>
        </div>
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Valor atual</p>
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100"><%= number_to_currency(@snapshot[:current_price]) %></p>
        </div>
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Variação 2 anos</p>
          <p class="text-sm font-semibold <%= @snapshot[:change_pct].to_d.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %>">
            <%= number_to_percentage(@snapshot[:change_pct], precision: 2) %>
          </p>
        </div>
      </div>

      <div class="mb-4 h-60 rounded-xl border border-slate-200 p-3 dark:border-slate-700">
        <canvas
          data-controller="chart"
          data-chart-type-value="line"
          data-chart-labels-value="<%= @snapshot[:chart_labels].to_json %>"
          data-chart-datasets-value='<%= [{ label: "Preço (2 anos)", data: @snapshot[:chart_values], borderColor: "#0ea5e9", backgroundColor: "rgba(14,165,233,0.12)", tension: 0.2, fill: true }].to_json %>'>
        </canvas>
      </div>

      <%= form_with url: investments_buy_path, method: :post, data: { turbo_frame: "_top" }, class: "grid gap-4 md:grid-cols-2", scope: :buy_order do |f| %>
        <%= f.hidden_field :instrument_id, value: @selected_instrument.id %>

        <div class="space-y-1" data-controller="buy-order" data-buy-order-price-value="<%= @snapshot[:current_price].to_f %>">
          <%= f.label :quantity, "Quantidade", class: "text-sm font-medium text-slate-700 dark:text-slate-200" %>
          <%= f.number_field :quantity, required: true, min: 0.000001, step: "any", value: 1, class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100", data: { buy_order_target: "quantity", action: "input->buy-order#recalculate" } %>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Total estimado:
            <span class="font-semibold text-slate-700 dark:text-slate-200" data-buy-order-target="total"></span>
          </p>
        </div>

        <div class="space-y-1">
          <%= f.label :fees, "Taxas", class: "text-sm font-medium text-slate-700 dark:text-slate-200" %>
          <%= f.number_field :fees, min: 0, step: "any", value: 0, class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" %>
        </div>

        <div class="space-y-1">
          <%= f.label :occurred_on, "Data da compra", class: "text-sm font-medium text-slate-700 dark:text-slate-200" %>
          <%= f.date_field :occurred_on, required: true, value: Date.current, class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" %>
        </div>

        <div class="md:col-span-2 flex flex-col gap-2 sm:flex-row">
          <%= f.submit "Confirmar compra", class: "inline-flex justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700" %>
          <%= link_to "Cancelar", "#", data: { action: "modal#close" }, class: "inline-flex justify-center rounded-md bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" %>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
        Selecione um ativo para carregar histórico de 2 anos e registrar a compra.
      </div>
    <% end %>
  </section>
<% end %>
