<div class="space-y-6">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Investimentos</p>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Planejamento</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">Metas financeiras, simulações e estratégias de aportes.</p>
  </div>

  <%= render "subnav" %>

  <% goal_type_labels = { "Retirement" => "Aposentadoria", "Reserve" => "Reserva", "Freedom" => "Independência", "Custom" => "Personalizado" } %>
  <% asset_class_labels = { "Stock" => "Ações", "Fii" => "FIIs", "Fixed income" => "Renda fixa", "Crypto" => "Criptoativos", "Fund" => "Fundos" } %>
  <% target_labels = @targets.map { |t| asset_class_labels.fetch(t.asset_class.to_s.humanize, t.asset_class.to_s.humanize) } %>
  <% target_values = @targets.map(&:target_percentage) %>
  <% allocation_labels = @allocation.keys.map { |kind| asset_class_labels.fetch(kind.to_s.humanize, kind.to_s.humanize) } %>
  <% allocation_values = @allocation.values.map { |v| (v * 100).round(2) } %>
  <% target_has_data = target_values.any?(&:positive?) %>
  <% allocation_has_data = allocation_values.any?(&:positive?) %>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Meta principal</p>
      <% main_goal = @goals.first %>
      <% if main_goal %>
        <p class="mt-2 text-sm font-semibold text-slate-900 dark:text-slate-100"><%= main_goal.name %></p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          <%= number_to_currency(main_goal.target_amount) %> até <%= l(main_goal.target_date) %>
        </p>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          Aporte mensal planejado: <%= number_to_currency(main_goal.monthly_contribution) %>
        </p>
      <% else %>
        <div class="mt-2">
          <%= render "shared/empty_alert",
                title: "Meta principal não definida",
                message: "Cadastre metas para acompanhar progresso, prazo e aporte mensal.",
                tone: :warning,
                compact: true %>
        </div>
      <% end %>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Metas ativas</p>
      <div class="mt-3 space-y-3 text-xs text-slate-600 dark:text-slate-300">
        <% if @goals.empty? %>
          <%= render "shared/empty_alert",
                title: "Sem metas ativas",
                message: "Crie metas para este card exibir objetivos e prazos.",
                tone: :warning,
                compact: true %>
        <% else %>
          <% @goals.each do |goal| %>
            <div class="rounded-xl border border-slate-100 px-4 py-3 dark:border-slate-800">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-900 dark:text-slate-100"><%= goal.name %></span>
                <span class="text-[11px] uppercase text-emerald-600 dark:text-emerald-400"><%= goal_type_labels.fetch(goal.goal_type.humanize, goal.goal_type.humanize) %></span>
              </div>
              <div class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
                <%= number_to_currency(goal.target_amount) %> · <%= l(goal.target_date) %> · aporte <%= number_to_currency(goal.monthly_contribution) %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Rebalanceamento</p>
      <div class="mt-3 space-y-2 text-xs text-slate-600 dark:text-slate-300">
        <% if @rebalance_alerts.empty? %>
          <%= render "shared/empty_alert",
                title: "Sem alertas de rebalanceamento",
                message: "No momento, a carteira está alinhada com os alvos definidos.",
                tone: :success,
                compact: true %>
        <% else %>
          <% @rebalance_alerts.each do |alert| %>
            <div class="flex items-center justify-between rounded-xl border border-slate-100 px-4 py-3 dark:border-slate-800">
              <div>
                <div class="font-semibold text-slate-900 dark:text-slate-100"><%= asset_class_labels.fetch(alert[:asset_class].to_s.humanize, alert[:asset_class].to_s.humanize) %></div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">
                  Atual <%= number_to_percentage(alert[:current], precision: 1) %> · Alvo <%= number_to_percentage(alert[:target], precision: 1) %>
                </div>
              </div>
              <div class="<%= alert[:diff].negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %> text-sm font-semibold">
                <%= number_to_percentage(alert[:diff], precision: 1) %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Alocação alvo</p>
      <div class="mt-4 h-64">
        <% if target_has_data %>
          <canvas
            data-controller="chart"
            data-chart-type-value="doughnut"
            data-chart-labels-value="<%= target_labels.to_json %>"
            data-chart-datasets-value='<%= [
              { label: "Alocação alvo", data: target_values, backgroundColor: ["#10b981", "#f59e0b", "#38bdf8", "#a855f7", "#f97316"] }
            ].to_json %>'
            data-privacy-target="value">
          </canvas>
        <% else %>
          <div class="flex h-full items-center">
            <%= render "shared/empty_alert",
                  title: "Alocação alvo sem dados",
                  message: "Defina metas de alocação para visualizar a distribuição ideal.",
                  tone: :warning,
                  compact: true %>
          </div>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Distribuição ideal definida nas metas de alocação.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Alocação atual</p>
      <div class="mt-4 h-64">
        <% if allocation_has_data %>
          <canvas
            data-controller="chart"
            data-chart-type-value="doughnut"
            data-chart-labels-value="<%= allocation_labels.to_json %>"
            data-chart-datasets-value='<%= [
              { label: "Alocação atual", data: allocation_values, backgroundColor: ["#10b981", "#f59e0b", "#38bdf8", "#a855f7", "#f97316"] }
            ].to_json %>'
            data-privacy-target="value">
          </canvas>
        <% else %>
          <div class="flex h-full items-center">
            <%= render "shared/empty_alert",
                  title: "Alocação atual sem dados",
                  message: "Sem posições no momento para calcular a distribuição atual.",
                  tone: :info,
                  compact: true %>
          </div>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Distribuição atual com base no valor investido.</p>
    </div>
  </div>
</div>
