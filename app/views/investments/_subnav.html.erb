<% tabs = [
  { label: "Carteira", path: investments_portfolio_path, action: "portfolio" },
  { label: "Análise", path: investments_analysis_path, action: "analysis" },
  { label: "Planejamento", path: investments_planning_path, action: "planning" },
  { label: "Renda", path: investments_income_path, action: "income" },
  { label: "Proventos", path: investments_dividends_path, action: "dividends" },
  { label: "Integrações", path: investments_integrations_path, action: "integrations" }
] %>

<nav class="flex flex-wrap gap-2 border-b border-slate-200 pb-3 dark:border-slate-800">
  <% tabs.each do |tab| %>
    <% active = action_name == tab[:action] %>
    <% base = "inline-flex items-center rounded-full px-4 py-1.5 text-xs font-semibold transition" %>
    <% styles = active ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200" : "border border-slate-200 text-slate-600 hover:border-slate-300 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:text-slate-100" %>
    <%= link_to tab[:label], tab[:path], class: "#{base} #{styles}" %>
  <% end %>
</nav>
