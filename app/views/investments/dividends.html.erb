<div class="space-y-6">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Investimentos</p>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Proventos</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">Controle de dividendos, juros e distribuição de fundos.</p>
  </div>

  <%= render "subnav" %>

  <% if @dividend_sync.present? %>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-900/20 dark:text-emerald-200">
      Sync Massive: <%= @dividend_sync[:synced] %> sincronizados, <%= @dividend_sync[:skipped] %> ignorados, <%= @dividend_sync[:errors] %> erros.
    </div>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Agenda</p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">Próximos pagamentos por ativo.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Histórico</p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">Recebimentos anteriores e evolução anual.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Proventos por classe</p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">Participação de ações, FIIs e fundos.</p>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Histórico de proventos</h2>
      <span class="text-xs text-slate-500 dark:text-slate-400"><%= @dividends.size %> registros</span>
    </div>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-xs text-slate-600 dark:text-slate-300">
        <thead class="uppercase tracking-wide text-slate-400">
          <tr>
            <th class="py-2 pr-4">Ativo</th>
            <th class="py-2 pr-4">Tipo</th>
            <th class="py-2 pr-4">Data</th>
            <th class="py-2">Valor</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @dividends.empty? %>
            <tr>
              <td colspan="4" class="py-4">
                <%= render "shared/empty_alert",
                      title: "Sem histórico de proventos",
                      message: "Registre ou sincronize proventos para preencher este histórico.",
                      tone: :info %>
              </td>
            </tr>
          <% else %>
            <% dividend_kind_labels = { "Dividend" => "Dividendo", "Interest" => "Juros", "Coupon" => "Cupom" } %>
            <% @dividends.each do |dividend| %>
              <tr>
                <td class="py-2 pr-4">
                  <div class="font-semibold text-slate-900 dark:text-slate-100"><%= dividend.asset.ticker %></div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400"><%= dividend.asset.name %></div>
                </td>
                <td class="py-2 pr-4"><%= dividend_kind_labels.fetch(dividend.kind.humanize, dividend.kind.humanize) %></td>
                <td class="py-2 pr-4"><%= l(dividend.paid_on) %></td>
                <td class="py-2 text-emerald-600 dark:text-emerald-400"><%= number_to_currency(dividend.amount) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
