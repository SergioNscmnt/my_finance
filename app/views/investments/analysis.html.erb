<div class="space-y-6">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Investimentos</p>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Análise</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">Desempenho, risco, volatilidade e comparação com referências.</p>
  </div>

  <%= render "subnav" %>

  <div class="grid gap-4 lg:grid-cols-3">
    <% asset_class_labels = { "Stock" => "Ações", "Fii" => "FIIs", "Fixed income" => "Renda fixa", "Crypto" => "Criptoativos", "Fund" => "Fundos" } %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Evolução do patrimônio</p>
      <div class="mt-4 h-56">
        <canvas
          data-controller="chart"
          data-chart-type-value="line"
          data-chart-labels-value="<%= @analysis_data[:labels].to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Investido", data: @analysis_data[:invested], borderColor: "#10b981", backgroundColor: "rgba(16,185,129,0.15)", tension: 0.35, fill: true }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Alocação por classe</p>
      <div class="mt-4 h-56">
        <canvas
          data-controller="chart"
          data-chart-type-value="doughnut"
          data-chart-labels-value="<%= @analysis_data[:allocation_labels].map { |label| asset_class_labels.fetch(label, label) }.to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Alocação", data: @analysis_data[:allocation_values], backgroundColor: ["#10b981", "#f59e0b", "#38bdf8", "#a855f7", "#f97316"] }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Proventos por mês</p>
      <div class="mt-4 h-56">
        <canvas
          data-controller="chart"
          data-chart-type-value="bar"
          data-chart-labels-value="<%= @analysis_data[:labels].to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Proventos", data: @analysis_data[:dividends], backgroundColor: "#10b981" }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      </div>
    </div>
  </div>
</div>
