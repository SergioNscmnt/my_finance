<div class="space-y-6">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Investimentos</p>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Renda</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">Acompanhe renda passiva, cupons e pagamentos recorrentes.</p>
  </div>

  <%= render "subnav" %>

  <% if @dividend_sync.present? %>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-900/20 dark:text-emerald-200">
      Sync Massive: <%= @dividend_sync[:synced] %> sincronizados, <%= @dividend_sync[:skipped] %> ignorados, <%= @dividend_sync[:errors] %> erros.
    </div>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Recebimentos por mês</p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">Calendário de rendimentos e previsões.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Rendimento da carteira</p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">Comparação de rentabilidade por classe.</p>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Últimos proventos</h2>
      <span class="text-xs text-slate-500 dark:text-slate-400"><%= @recent_dividends.size %> registros</span>
    </div>
    <div class="mt-4 space-y-3 text-xs text-slate-600 dark:text-slate-300">
      <% if @recent_dividends.empty? %>
        <p class="text-sm text-slate-500 dark:text-slate-400">Nenhum provento registrado ainda.</p>
      <% else %>
        <% dividend_kind_labels = { "Dividend" => "Dividendo", "Interest" => "Juros", "Coupon" => "Cupom" } %>
        <% @recent_dividends.each do |dividend| %>
          <div class="flex items-center justify-between rounded-xl border border-slate-100 px-4 py-3 dark:border-slate-800">
            <div>
              <div class="font-semibold text-slate-900 dark:text-slate-100"><%= dividend.asset.ticker %></div>
              <div class="text-[11px] text-slate-500 dark:text-slate-400"><%= l(dividend.paid_on) %> · <%= dividend_kind_labels.fetch(dividend.kind.humanize, dividend.kind.humanize) %></div>
            </div>
            <div class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">
              <%= number_to_currency(dividend.amount) %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
