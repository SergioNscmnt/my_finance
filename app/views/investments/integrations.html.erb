<div class="space-y-6">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Investimentos</p>
    <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Integrações</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">Conecte corretoras e bancos para sincronizar posições.</p>
  </div>

  <%= render "subnav" %>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Massive API</p>
      <% massive_enabled = @integration_status[:massive_enabled] %>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">
        Status:
        <span class="<%= massive_enabled ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400' %>">
          <%= massive_enabled ? "Conectado" : "Não configurado" %>
        </span>
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
        Cotações disponíveis: <%= @integration_status[:quoted_assets] %>/<%= @integration_status[:total_assets] %> ativos.
      </p>
      <%= button_to "Sincronizar proventos agora",
                    investments_sync_massive_path,
                    method: :post,
                    disabled: !massive_enabled,
                    class: "mt-4 inline-flex items-center rounded-md px-4 py-2 text-xs font-semibold shadow #{massive_enabled ? 'bg-emerald-600 text-white hover:bg-emerald-700' : 'bg-slate-200 text-slate-500 cursor-not-allowed dark:bg-slate-800 dark:text-slate-400'}" %>
      <%= button_to "Sincronizar catálogo (ações/fundos/criptos)",
                    investments_sync_instruments_path,
                    method: :post,
                    disabled: !massive_enabled,
                    class: "mt-2 inline-flex items-center rounded-md px-4 py-2 text-xs font-semibold shadow #{massive_enabled ? 'bg-sky-600 text-white hover:bg-sky-700' : 'bg-slate-200 text-slate-500 cursor-not-allowed dark:bg-slate-800 dark:text-slate-400'}" %>
      <%= link_to "Comprar ativo", new_investments_buy_path, data: { turbo_frame: "modal" }, class: "mt-2 inline-flex items-center rounded-md border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" %>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Importar CSV</p>
      <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">Envie arquivos para carregar posições históricas.</p>
      <button class="mt-4 inline-flex items-center rounded-md border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:border-slate-300 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Enviar arquivo</button>
    </div>
  </div>
</div>
