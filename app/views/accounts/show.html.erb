<section class="w-full px-4 space-y-6 sm:px-6 lg:px-8">
  <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <p class="flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400">
      <%= icon_svg("user", class_name: "h-4 w-4 shrink-0") %>
      Preferências
    </p>
    <h1 class="mt-1 flex items-center gap-2 text-2xl font-semibold text-slate-900 dark:text-slate-100">
      <span class="text-blue-600 dark:text-blue-300"><%= icon_svg("user", class_name: "h-6 w-6 shrink-0") %></span>
      Minha conta
    </h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Atualize seus dados e altere sua senha.</p>
  </header>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-slate-100">
      <span class="text-emerald-600 dark:text-emerald-300"><%= icon_svg("user") %></span>
      Dados principais
    </h2>
    <p class="text-sm text-slate-500 dark:text-slate-400">Nome e e-mail usados para login e identificação.</p>

    <%= form_with model: @user, url: account_path, method: :patch, class: "mt-4 space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <p class="flex items-center gap-2 font-semibold"><%= icon_svg("alert-triangle") %> Corrija os erros abaixo:</p>
          <ul class="mt-2 list-disc pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <%= f.label :name, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-200" do %>
            <%= icon_svg("user", class_name: "h-3.5 w-3.5 shrink-0") %>
            Nome
          <% end %>
          <%= f.text_field :name, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :email, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-200" do %>
            <%= icon_svg("mail", class_name: "h-3.5 w-3.5 shrink-0") %>
            E-mail
          <% end %>
          <%= f.email_field :email, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
        </div>
      </div>

      <div class="border-t border-slate-200 pt-4 dark:border-slate-700">
        <h3 class="flex items-center gap-2 text-base font-semibold text-slate-900 dark:text-slate-100">
          <span class="text-amber-600 dark:text-amber-300"><%= icon_svg("lock") %></span>
          Alterar senha
        </h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Deixe em branco para manter a senha atual.</p>
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          <div>
            <%= f.label :password, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-200" do %>
              <%= icon_svg("lock", class_name: "h-3.5 w-3.5 shrink-0") %>
              Nova senha
            <% end %>
            <%= f.password_field :password, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
          </div>
          <div>
            <%= f.label :password_confirmation, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-200" do %>
              <%= icon_svg("lock", class_name: "h-3.5 w-3.5 shrink-0") %>
              Confirmar nova senha
            <% end %>
            <%= f.password_field :password_confirmation, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
          </div>
        </div>
      </div>

      <div class="flex">
        <%= f.button type: "submit", class: "inline-flex w-full items-center justify-center gap-2 rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 focus:outline focus:outline-2 focus:outline-emerald-400 sm:w-auto sm:ml-auto" do %>
          <%= icon_svg("save", class_name: "h-4 w-4 shrink-0") %>
          Salvar alterações
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-slate-100">
          <span class="text-emerald-600 dark:text-emerald-300"><%= icon_svg("message-circle") %></span>
          WhatsApp
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Cadastre números autorizados para registrar transações pelo bot.</p>
      </div>
      <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600 dark:border-slate-700 dark:text-slate-300">
        <%= icon_svg("plug", class_name: "h-3.5 w-3.5 shrink-0") %>
        Evolution API
      </span>
    </div>

    <%= form_with model: @whatsapp_account, url: whatsapp_accounts_path, class: "mt-5 grid gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/40" do |f| %>
      <% if @whatsapp_account.errors.any? %>
        <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <p class="flex items-center gap-2 font-semibold"><%= icon_svg("alert-triangle") %> Corrija o vínculo WhatsApp:</p>
          <ul class="mt-2 list-disc pl-5">
            <% @whatsapp_account.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-end">
        <div>
          <%= f.label :phone_number, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-200" do %>
            <%= icon_svg("message-circle", class_name: "h-3.5 w-3.5 shrink-0") %>
            Telefone
          <% end %>
          <%= f.telephone_field :phone_number, placeholder: "+55 69 99999-9999", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :instance_name, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-200" do %>
            <%= icon_svg("plug", class_name: "h-3.5 w-3.5 shrink-0") %>
            Instância
          <% end %>
          <%= f.text_field :instance_name, placeholder: "my_finance", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
        </div>
        <%= f.button type: "submit", class: "inline-flex h-10 w-full items-center justify-center gap-2 rounded-md bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700 focus:outline focus:outline-2 focus:outline-emerald-400 lg:w-auto" do %>
          <%= icon_svg("save", class_name: "h-4 w-4 shrink-0") %>
          Cadastrar
        <% end %>
      </div>
    <% end %>

    <div class="mt-5 space-y-3">
      <% if @whatsapp_accounts.any? %>
        <% @whatsapp_accounts.each do |account| %>
          <% event_count = account.evolution_webhook_events.count %>
          <% processed_count = account.evolution_webhook_events.processed.count %>
          <article class="rounded-lg border border-slate-200 p-4 dark:border-slate-700">
            <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="flex items-center gap-2 text-base font-semibold text-slate-900 dark:text-slate-100">
                    <%= icon_svg("message-circle", class_name: "h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-300") %>
                    <%= whatsapp_phone_display(account.phone_number) %>
                  </h3>
                  <% if account.enabled? %>
                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">Ativo</span>
                  <% else %>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">Inativo</span>
                  <% end %>
                </div>
                <dl class="mt-3 grid gap-2 text-sm text-slate-600 dark:text-slate-400 sm:grid-cols-3">
                  <div>
                    <dt class="text-xs font-semibold uppercase text-slate-500">Instância</dt>
                    <dd class="mt-0.5 font-medium text-slate-800 dark:text-slate-200"><%= account.instance_name %></dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase text-slate-500">Último uso</dt>
                    <dd class="mt-0.5 font-medium text-slate-800 dark:text-slate-200"><%= account.last_seen_at.present? ? l(account.last_seen_at, format: :short) : "Sem uso" %></dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase text-slate-500">Eventos</dt>
                    <dd class="mt-0.5 font-medium text-slate-800 dark:text-slate-200"><%= event_count %> recebido(s), <%= processed_count %> processado(s)</dd>
                  </div>
                </dl>
              </div>

              <div class="flex flex-wrap gap-2 xl:justify-end">
                <%= button_to test_message_whatsapp_account_path(account), method: :post, class: "inline-flex items-center justify-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" do %>
                  <%= icon_svg("send", class_name: "h-3.5 w-3.5 shrink-0") %>
                  Testar
                <% end %>

                <%= button_to whatsapp_account_path(account), method: :patch, params: { whatsapp_account: { enabled: !account.enabled? } }, class: "inline-flex items-center justify-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" do %>
                  <%= icon_svg(account.enabled? ? "lock" : "save", class_name: "h-3.5 w-3.5 shrink-0") %>
                  <%= account.enabled? ? "Desativar" : "Ativar" %>
                <% end %>

                <%= button_to whatsapp_account_path(account), method: :delete, class: "inline-flex items-center justify-center gap-2 rounded-md border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50 dark:border-red-900/60 dark:text-red-300 dark:hover:bg-red-950/40", form: { data: { turbo_confirm: "Remover este vínculo WhatsApp?" } } do %>
                  <%= icon_svg("trash", class_name: "h-3.5 w-3.5 shrink-0") %>
                  Remover
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-lg border border-dashed border-slate-300 px-4 py-6 text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
          Nenhum número autorizado ainda.
        </div>
      <% end %>
    </div>
  </section>
</section>
