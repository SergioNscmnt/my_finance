<div class="w-full px-4 py-6 space-y-6 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100"><%= @asset.ticker.upcase %> · <%= @asset.name %></h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Classe: <%= @asset.asset_type_label_pt_br %> · Moeda: <%= @asset.currency.upcase %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Voltar", assets_path, class: "inline-flex items-center justify-center rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" %>
      <%= link_to "Editar", edit_asset_path(@asset, return_to: asset_path(@asset)), data: { turbo_frame: "modal" }, class: "inline-flex items-center justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Quantidade</p>
      <p class="mt-2 text-2xl font-semibold text-slate-900 dark:text-slate-100"><%= @position.quantity %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Preço médio</p>
      <p class="mt-2 text-2xl font-semibold text-slate-900 dark:text-slate-100"><%= number_to_currency(@position.avg_price) %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs text-slate-500 dark:text-slate-400">Investido</p>
      <p class="mt-2 text-2xl font-semibold text-slate-900 dark:text-slate-100"><%= number_to_currency(@position.invested_amount) %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900"
         data-controller="live-asset-quote"
         data-live-asset-quote-url-value="<%= live_quote_asset_path(@asset) %>"
         data-live-asset-quote-interval-value="15000">
      <div class="flex items-center justify-between">
        <p class="text-xs text-slate-500 dark:text-slate-400">Cotação ao vivo</p>
        <span data-live-asset-quote-target="status" class="rounded-full bg-emerald-100 px-2 py-1 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">Conectando...</span>
      </div>
      <p data-live-asset-quote-target="price" class="mt-2 text-2xl font-semibold text-slate-900 dark:text-slate-100">
        <%= @live_quote[:available] ? number_to_currency(@live_quote[:market_price], unit: "") : "-" %>
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
        Moeda: <span data-live-asset-quote-target="currency"><%= @live_quote[:currency].presence || @asset.currency %></span>
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
        Variação: <span data-live-asset-quote-target="change">-</span>
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
        Atualizado: <span data-live-asset-quote-target="time"><%= @live_quote[:market_time].present? ? l(@live_quote[:market_time], format: :short) : "-" %></span>
      </p>
      <p data-live-asset-quote-target="error" class="mt-2 hidden text-xs text-red-600 dark:text-red-400"></p>
    </div>
  </div>

  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
      <p class="font-semibold text-slate-900 dark:text-slate-100">Movimentações</p>
      <span class="text-sm text-slate-500 dark:text-slate-400"><%= @transactions.size %> itens</span>
    </header>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-300">
          <tr>
            <th class="px-4 py-3">Data</th>
            <th class="px-4 py-3">Tipo</th>
            <th class="px-4 py-3">Quantidade</th>
            <th class="px-4 py-3">Preço</th>
            <th class="px-4 py-3">Taxas</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white dark:divide-slate-800 dark:bg-slate-900">
          <% if @transactions.any? %>
            <% @transactions.each do |tx| %>
              <tr>
                <td class="px-4 py-3"><%= l(tx.occurred_on) %></td>
                <td class="px-4 py-3"><%= tx.kind.humanize %></td>
                <td class="px-4 py-3"><%= tx.quantity %></td>
                <td class="px-4 py-3"><%= number_to_currency(tx.price) %></td>
                <td class="px-4 py-3"><%= number_to_currency(tx.fees) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-4 py-4">
                <%= render "shared/empty_alert",
                      title: "Sem movimentações",
                      message: "Registre compras e vendas para acompanhar desempenho desse ativo.",
                      tone: :info %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
