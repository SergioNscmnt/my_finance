<section class="rounded-2xl border border-slate-200 bg-white p-5 pr-14 shadow-sm dark:border-slate-700 dark:bg-slate-900">
  <% frame_id = local_assigns[:frame_id] || "modal" %>
  <% form_title = asset.persisted? ? "Editar ativo" : "Cadastrar ativo" %>

  <div class="mb-3">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100"><%= form_title %></h2>
    <p class="text-sm text-slate-600 dark:text-slate-400">Cadastre seus ativos para acompanhar carteira, câmbio e evolução.</p>
  </div>

  <%= form_with model: asset, data: { turbo_frame: "_top", controller: "asset-form" }, class: "grid gap-4 md:grid-cols-2" do |form| %>
    <% if return_to.present? %>
      <%= hidden_field_tag :return_to, return_to %>
    <% end %>

    <div class="space-y-1 md:col-span-2">
      <%= form.label :name, "Nome", class: "text-sm font-medium text-slate-700 dark:text-slate-200" %>
      <%= form.text_field :name, required: true, class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100", data: { asset_form_target: "name" } %>
      <% if form.object.errors[:name].any? %>
        <p class="text-xs text-red-600"><%= form.object.errors.full_messages_for(:name).first %></p>
      <% end %>
    </div>

    <div class="space-y-1">
      <%= form.label :ticker, "Ticker", class: "text-sm font-medium text-slate-700 dark:text-slate-200" %>
      <select name="asset[ticker]"
              id="asset_ticker"
              required
              class="tom-select w-full"
              data-controller="tom-select"
              data-placeholder="Digite ticker ou nome"
              data-remote-url="<%= tickers_search_assets_path %>"
              data-action="change->asset-form#handleTickerChange tom-select:item-add->asset-form#applyTicker">
        <option value=""></option>
        <% if form.object.ticker.present? %>
          <option value="<%= form.object.ticker %>" selected>
            <%= "#{form.object.ticker} - #{form.object.name}" %>
          </option>
        <% end %>
      </select>
      <% if form.object.errors[:ticker].any? %>
        <p class="text-xs text-red-600"><%= form.object.errors.full_messages_for(:ticker).first %></p>
      <% end %>
    </div>

    <div class="space-y-1">
      <%= form.label :currency, "Moeda", class: "text-sm font-medium text-slate-700 dark:text-slate-200" %>
      <%= form.select :currency,
            options_for_select(@currency_options, form.object.currency.presence || "USD"),
            {},
            class: "tom-select w-full",
            data: { controller: "tom-select", placeholder: "Selecione a moeda", asset_form_target: "currency" } %>
      <% if form.object.errors[:currency].any? %>
        <p class="text-xs text-red-600"><%= form.object.errors.full_messages_for(:currency).first %></p>
      <% end %>
    </div>

    <div class="space-y-1 md:col-span-2">
      <%= form.label :asset_type, "Classe do ativo", class: "text-sm font-medium text-slate-700 dark:text-slate-200" %>
      <%= form.select :asset_type,
            @asset_type_options,
            {},
            class: "tom-select w-full",
            data: { controller: "tom-select", placeholder: "Selecione a classe", asset_form_target: "assetType" } %>
      <% if form.object.errors[:asset_type].any? %>
        <p class="text-xs text-red-600"><%= form.object.errors.full_messages_for(:asset_type).first %></p>
      <% end %>
    </div>

    <div class="md:col-span-2 flex flex-col gap-2 sm:flex-row">
      <%= form.submit(asset.persisted? ? "Salvar alterações" : "Cadastrar ativo", class: "inline-flex justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700") %>
      <%= link_to "Cancelar", "#", data: { action: "modal#close" }, class: "inline-flex justify-center rounded-md bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" %>
    </div>
  <% end %>
</section>
