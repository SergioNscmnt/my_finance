<% total_results = @transactions.size + @categories.size + @category_budgets.size + @credit_card_invoices.size %>

<div class="w-full space-y-6">
  <header class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
    <div>
      <h1 class="flex items-center gap-2 text-2xl font-semibold text-slate-900 dark:text-slate-100">
        <span class="text-blue-600 dark:text-blue-300"><%= icon_svg("search", class_name: "h-6 w-6 shrink-0") %></span>
        Busca global
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        <% if @query.present? %>
          Resultados para "<%= @query %>".
        <% else %>
          Pesquise por transações, categorias, orçamentos e faturas.
        <% end %>
      </p>
    </div>
    <% if @query.present? %>
      <span class="inline-flex w-fit rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200"><%= total_results %> resultado(s)</span>
    <% end %>
  </header>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <%= render "shared/global_search_form" %>
  </section>

  <% if @query.blank? %>
    <%= render "shared/empty_alert",
          title: "Digite uma pesquisa",
          message: "Use a caixa acima para localizar registros em toda a aplicação.",
          tone: :info %>
  <% elsif total_results.zero? %>
    <%= render "shared/empty_alert",
          title: "Nenhum resultado encontrado",
          message: "Tente buscar por outro título, categoria, cartão ou banco.",
          tone: :warning %>
  <% else %>
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
      <section class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
          <h2 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100"><%= icon_svg("receipt") %> Transações</h2>
          <span class="text-xs text-slate-500 dark:text-slate-400"><%= @transactions.size %></span>
        </header>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @transactions.any? %>
            <% @transactions.each do |transaction| %>
              <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="font-medium text-slate-900 dark:text-slate-100"><%= transaction.title %></p>
                  <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
                    <span class="inline-flex items-center gap-1"><%= category_icon(transaction.category, class_name: "h-3.5 w-3.5 shrink-0") %><%= transaction.category&.name || "Sem categoria" %></span>
                    <span><%= l(transaction.occurred_on) %></span>
                    <span data-privacy-target="value"><%= number_to_currency(transaction.display_amount) %></span>
                  </p>
                </div>
                <%= link_to "Editar", edit_transaction_path(transaction), data: { turbo_frame: "modal" }, class: "rounded-md bg-blue-50 px-3 py-1.5 text-center text-xs font-semibold text-blue-700 hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-200 dark:hover:bg-blue-900/50" %>
              </div>
            <% end %>
          <% else %>
            <div class="px-4 py-4 text-sm text-slate-500 dark:text-slate-400">Nenhuma transação encontrada.</div>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
          <h2 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100"><%= icon_svg("tag") %> Categorias</h2>
          <span class="text-xs text-slate-500 dark:text-slate-400"><%= @categories.size %></span>
        </header>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @categories.any? %>
            <% @categories.each do |category| %>
              <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="flex items-center gap-2 font-medium text-slate-900 dark:text-slate-100"><%= category_icon(category) %><%= category.name %></p>
                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= category.income? ? "Receita" : "Despesa" %><%= category.card_bank.present? ? " · #{category.card_bank}" : "" %></p>
                </div>
                <%= link_to "Editar", edit_category_path(category), data: { turbo_frame: "modal" }, class: "rounded-md bg-blue-50 px-3 py-1.5 text-center text-xs font-semibold text-blue-700 hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-200 dark:hover:bg-blue-900/50" %>
              </div>
            <% end %>
          <% else %>
            <div class="px-4 py-4 text-sm text-slate-500 dark:text-slate-400">Nenhuma categoria encontrada.</div>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
          <h2 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100"><%= icon_svg("target") %> Orçamentos</h2>
          <span class="text-xs text-slate-500 dark:text-slate-400"><%= @category_budgets.size %></span>
        </header>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @category_budgets.any? %>
            <% @category_budgets.each do |budget| %>
              <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="flex items-center gap-2 font-medium text-slate-900 dark:text-slate-100"><%= category_icon(budget.category) %><%= budget.category.name %></p>
                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= l(budget.budget_month, format: "%B %Y") %> · <span data-privacy-target="value"><%= number_to_currency(budget.amount) %></span></p>
                </div>
                <%= link_to "Abrir", planning_path(budget_month: budget.budget_month.strftime("%Y-%m")), class: "rounded-md bg-slate-100 px-3 py-1.5 text-center text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" %>
              </div>
            <% end %>
          <% else %>
            <div class="px-4 py-4 text-sm text-slate-500 dark:text-slate-400">Nenhum orçamento encontrado.</div>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
          <h2 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100"><%= icon_svg("credit-card") %> Faturas</h2>
          <span class="text-xs text-slate-500 dark:text-slate-400"><%= @credit_card_invoices.size %></span>
        </header>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @credit_card_invoices.any? %>
            <% @credit_card_invoices.each do |invoice| %>
              <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="flex items-center gap-2 font-medium text-slate-900 dark:text-slate-100"><%= category_icon(invoice.category) %><%= invoice.category.name %></p>
                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= l(invoice.billing_month, format: "%B %Y") %> · vence <%= l(invoice.due_on) %> · <span data-privacy-target="value"><%= number_to_currency(invoice.total_amount) %></span></p>
                </div>
                <span class="inline-flex w-fit rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200"><%= invoice.status.humanize %></span>
              </div>
            <% end %>
          <% else %>
            <div class="px-4 py-4 text-sm text-slate-500 dark:text-slate-400">Nenhuma fatura encontrada.</div>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>
</div>
