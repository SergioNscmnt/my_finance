<section class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
  <article class="min-h-[18rem] rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
      <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Planejamento de Orçamento por Categoria</h3>
      <span class="text-xs text-slate-500 dark:text-slate-400">Defina limites de gasto por categoria</span>
    </div>

    <%= form_with model: category_budget, url: category_budgets_path, method: :post, class: "grid gap-2 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_180px_auto] lg:items-end" do |f| %>
      <div>
        <%= f.select :category_id,
              options_from_collection_for_select(budget_categories, :id, :name),
              { prompt: "Selecione uma categoria" },
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 bg-white focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400" %>
      </div>
      <div>
        <div data-controller="currency">
          <%= f.hidden_field :amount, data: { currency_target: "hidden" } %>
          <%= text_field_tag :category_budget_amount_display,
                "",
                name: nil,
                placeholder: "Valor (R$)",
                inputmode: "numeric",
                autocomplete: "off",
                class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 bg-white focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400",
                data: { currency_target: "display", action: "input->currency#format blur->currency#format" } %>
        </div>
      </div>
      <div>
        <%= f.submit "Adicionar", class: "w-full rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
      </div>
    <% end %>
  </article>

  <article class="min-h-[18rem] rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <h3 class="mb-1 text-sm font-semibold text-slate-900 dark:text-slate-100">Mapa de Orçamento</h3>
    <p class="text-xs text-slate-500 dark:text-slate-400">Distribuição do orçamento planejado por categoria.</p>
    <div class="mt-3 space-y-1 text-xs text-slate-600 dark:text-slate-300">
      <div class="flex items-center justify-between">
        <span>Saldo atual</span>
        <span data-privacy-target="value"><%= number_to_currency(balance) %></span>
      </div>
      <div class="flex items-center justify-between">
        <span>Total planejado</span>
        <span data-privacy-target="value"><%= number_to_currency(planned_budget_total) %></span>
      </div>
      <div class="flex items-center justify-between">
        <span>Disponível após orçamento</span>
        <span class="<%= available_after_budget.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %>" data-privacy-target="value"><%= number_to_currency(available_after_budget) %></span>
      </div>
    </div>
    <div class="mt-4 <%= budget_values.any? ? 'h-60' : 'h-24' %>">
      <% if budget_values.any? %>
        <canvas
          data-controller="chart"
          data-chart-type-value="doughnut"
          data-chart-labels-value="<%= budget_labels.to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Orçamento por categoria", data: budget_values, backgroundColor: ["#0ea5e9", "#22c55e", "#f59e0b", "#ef4444", "#a855f7", "#14b8a6", "#f97316", "#84cc16"] }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      <% else %>
        <div class="flex h-full items-center justify-center rounded-lg border border-dashed border-slate-300 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
          Adicione categorias para gerar o gráfico.
        </div>
      <% end %>
    </div>
  </article>
</section>
