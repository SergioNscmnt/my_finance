<section class="grid grid-cols-1 gap-4 lg:grid-cols-12">
  <% selected_month = (local_assigns[:selected_budget_month] || Date.current.beginning_of_month).to_date.beginning_of_month %>
  <% spent_by_category_id = local_assigns[:budget_spent_by_category_id] || {} %>
  <% remaining_by_category_id = local_assigns[:budget_remaining_by_category_id] || {} %>
  <% progress_by_category_id = local_assigns[:budget_progress_by_category_id] || {} %>
  <% planned_total = planned_budget_total.to_f %>
  <% spent_total = category_budgets.sum { |budget| spent_by_category_id[budget.category_id].to_f } %>
  <% remaining_total = planned_total - spent_total %>
  <% total_usage = planned_total.positive? ? ((spent_total / planned_total) * 100) : 0 %>
  <% total_usage_width = [[total_usage, 0].max, 100].min %>
  <article class="min-h-[22rem] rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 lg:col-span-6">
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100">
          <span class="text-emerald-600 dark:text-emerald-300"><%= icon_svg("layers") %></span>
          Planejamento de Orçamento por Categoria
        </h3>
        <span class="text-xs text-slate-500 dark:text-slate-400">Defina limites de gasto por categoria</span>
      </div>
      <%= form_with url: dashboard_path,
            method: :get,
            data: { turbo_frame: "dashboard-budget-planner" },
            class: "flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400" do %>
        <%= hidden_field_tag :months, params[:months] if params[:months].present? %>
        <%= hidden_field_tag :category, params[:category] if params[:category].present? %>
        <%= label_tag :budget_month, "Mês", class: "font-medium" %>
        <%= text_field_tag :budget_month,
              selected_month.strftime("%Y-%m-%d"),
              id: "flatpickr-budget-month",
              autocomplete: "off",
              placeholder: "MM/AAAA",
              class: "w-36 rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-700 focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400" %>
      <% end %>
    </div>

    <div class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
      <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= icon_svg("target", class_name: "h-3.5 w-3.5 shrink-0") %> Planejado</p>
        <p class="mt-0.5 text-sm font-semibold text-slate-900 dark:text-slate-100 tabular-nums" data-privacy-target="value"><%= number_to_currency(planned_total) %></p>
      </div>
      <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= icon_svg("arrow-up-right", class_name: "h-3.5 w-3.5 shrink-0") %> Gasto no mês</p>
        <p class="mt-0.5 text-sm font-semibold text-amber-700 dark:text-amber-400 tabular-nums" data-privacy-target="value"><%= number_to_currency(spent_total) %></p>
      </div>
      <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= icon_svg("wallet", class_name: "h-3.5 w-3.5 shrink-0") %> Saldo total</p>
        <p class="mt-0.5 text-sm font-semibold tabular-nums <%= remaining_total.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-700 dark:text-emerald-400' %>" data-privacy-target="value"><%= number_to_currency(remaining_total) %></p>
      </div>
    </div>

    <div class="mb-4">
      <div class="mb-1 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300">
        <span>Uso total do orçamento</span>
        <span><%= total_usage.round(1) %>%</span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
        <div class="h-full rounded-full <%= remaining_total.negative? ? 'bg-red-500' : 'bg-emerald-500' %>" style="width: <%= total_usage_width %>%"></div>
      </div>
    </div>

    <%= form_with model: category_budget,
          url: category_budgets_path,
          method: :post,
          data: { turbo_frame: "dashboard-budget-planner" },
          class: "grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-slate-50/40 p-3 md:grid-cols-12 md:items-end dark:border-slate-700 dark:bg-slate-800/20" do |f| %>
      <%= f.hidden_field :budget_month, value: selected_month.strftime("%Y-%m-%d") %>
      <div class="md:col-span-6">
        <%= f.label :category_id, "Categoria", class: "mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300" %>
        <%= f.select :category_id,
              options_for_select(
                budget_categories.map do |category|
                  label = category.card_bank.present? ? "#{category.name} (#{category.card_bank})" : category.name
                  [label, category.id]
                end
              ),
              include_blank: "Selecione uma categoria",
              class: "tom-select w-full",
              data: { controller: "tom-select", placeholder: "Selecione uma categoria" } %>
      </div>
      <div class="md:col-span-4">
        <label class="mb-1 block text-xs font-medium text-slate-600 dark:text-slate-300">Valor planejado</label>
        <div data-controller="currency">
          <%= f.hidden_field :amount, data: { currency_target: "hidden" } %>
          <%= text_field_tag :category_budget_amount_display,
                "",
                name: nil,
                placeholder: "R$ 0,00",
                inputmode: "numeric",
                autocomplete: "off",
                class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 bg-white focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400",
                data: { currency_target: "display", action: "input->currency#format blur->currency#format" } %>
        </div>
      </div>
      <div class="md:col-span-2">
        <%= f.button type: :submit,
                     class: "inline-flex h-10 w-full items-center justify-center rounded-md bg-emerald-600 px-3 text-sm font-semibold text-white hover:bg-emerald-700",
                     aria: { label: "Adicionar orçamento" },
                     title: "Adicionar orçamento" do %>
          Adicionar
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 border-t border-slate-200 pt-4 dark:border-slate-700">
      <div class="mb-2 flex items-center justify-between">
        <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Categorias planejadas</h4>
        <span class="text-xs text-slate-500 dark:text-slate-400"><%= category_budgets.size %> categoria(s)</span>
      </div>
      <% if category_budgets.any? %>
        <div class="<%= category_budgets.size > 3 ? 'max-h-56 overflow-y-auto pr-1' : '' %> space-y-2">
          <% category_budgets.each do |budget| %>
            <% share = planned_budget_total.positive? ? ((budget.amount.to_f / planned_budget_total.to_f) * 100).round(1) : 0 %>
            <% spent_amount = spent_by_category_id[budget.category_id].to_f %>
            <% remaining_amount = remaining_by_category_id.fetch(budget.category_id, budget.amount.to_f - spent_amount).to_f %>
            <% progress = progress_by_category_id.fetch(budget.category_id, 0).to_f %>
            <% over_budget = remaining_amount.negative? %>
            <% progress_width = [[progress, 0].max, 100].min %>
            <div class="rounded-lg border border-slate-200 bg-slate-50/40 px-3 py-3 dark:border-slate-700 dark:bg-slate-800/20">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-slate-500 dark:text-slate-400"><%= category_icon(budget.category, class_name: "h-4 w-4 shrink-0") %></span>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 break-words"><%= budget.category.name %></p>
                    <% if budget.category.card_bank.present? %>
                      <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700 dark:bg-blue-900/30 dark:text-blue-200">
                        <%= budget.category.card_bank %>
                      </span>
                    <% end %>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold <%= over_budget ? 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300' %>">
                      <%= over_budget ? "Acima do limite" : "Dentro do limite" %>
                    </span>
                  </div>
                </div>
                <span class="text-base font-semibold tabular-nums <%= over_budget ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %>" data-privacy-target="value">
                  <%= over_budget ? "-#{number_to_currency(remaining_amount.abs)}" : number_to_currency(remaining_amount) %>
                </span>
              </div>

              <div class="mt-2 grid grid-cols-1 gap-1 text-xs text-slate-600 dark:text-slate-300 sm:grid-cols-2 lg:grid-cols-3 sm:gap-2">
                <span>Planejado: <strong class="tabular-nums" data-privacy-target="value"><%= number_to_currency(budget.amount) %></strong></span>
                <span>Gasto no mês: <strong class="tabular-nums" data-privacy-target="value"><%= number_to_currency(spent_amount) %></strong></span>
                <span class="sm:col-span-2 lg:col-span-1">Participação: <strong><%= share %>%</strong></span>
              </div>

              <div class="mt-2">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
                  <div class="h-full rounded-full <%= over_budget ? 'bg-red-500' : 'bg-emerald-500' %>" style="width: <%= progress_width %>%"></div>
                </div>
              </div>

              <div class="mt-2 grid grid-cols-1 gap-1 text-xs text-slate-600 dark:text-slate-300 sm:grid-cols-2 sm:gap-3">
                <span>
                  <% if over_budget %>
                    Excedido em <span class="tabular-nums" data-privacy-target="value"><%= number_to_currency(remaining_amount.abs) %></span>
                  <% else %>
                    Restante <span class="tabular-nums" data-privacy-target="value"><%= number_to_currency(remaining_amount) %></span>
                  <% end %>
                </span>
                <span class="sm:text-right"><%= progress.round(1) %>% do limite usado</span>
              </div>

              <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <span class="text-xs text-slate-600 dark:text-slate-300">Saldo da categoria</span>
                <div class="grid grid-cols-2 gap-2 sm:flex sm:items-center">
                  <%= link_to "Editar", edit_category_budget_path(budget, budget_month: selected_month.strftime("%Y-%m")), data: { turbo_frame: "modal" }, class: "rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 text-center hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" %>
                  <%= link_to "Remover", category_budget_path(budget), data: { turbo_method: :delete, turbo_confirm: "Remover orçamento planejado desta categoria?" }, class: "rounded-md border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 text-center hover:bg-red-50 dark:border-red-900/70 dark:text-red-300 dark:hover:bg-red-900/20" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="py-2">
          <%= render "shared/empty_alert",
                title: "Sem categorias planejadas",
                message: "Adicione um orçamento por categoria para acompanhar limite, gasto e saldo restante.",
                tone: :warning,
                compact: true %>
        </div>
      <% end %>
    </div>
  </article>

  <article class="min-h-[22rem] rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 lg:col-span-6">
    <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100">
      <span class="text-blue-600 dark:text-blue-300"><%= icon_svg("map") %></span>
      Mapa de Orçamento
    </h3>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Distribuição do orçamento planejado por categoria.</p>

    <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= icon_svg("wallet", class_name: "h-3.5 w-3.5 shrink-0") %> Saldo atual</p>
        <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100" data-privacy-target="value"><%= number_to_currency(balance) %></p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= icon_svg("target", class_name: "h-3.5 w-3.5 shrink-0") %> Total planejado</p>
        <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100" data-privacy-target="value"><%= number_to_currency(planned_budget_total) %></p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= icon_svg("circle-dollar", class_name: "h-3.5 w-3.5 shrink-0") %> Disponível</p>
        <p class="mt-1 text-sm font-semibold <%= available_after_budget.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %>" data-privacy-target="value"><%= number_to_currency(available_after_budget) %></p>
      </div>
    </div>

    <div class="mt-4 <%= budget_values.any? ? 'h-72' : 'h-24' %>">
      <% if budget_values.any? %>
        <canvas
          data-controller="chart"
          data-chart-type-value="bar"
          data-chart-legend-value="false"
          data-chart-labels-value="<%= budget_labels.to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Orçamento por categoria", data: budget_values, backgroundColor: ["#0ea5e9", "#22c55e", "#f59e0b", "#ef4444", "#a855f7", "#14b8a6", "#f97316", "#84cc16"] }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      <% else %>
        <div class="flex h-full items-center justify-center">
          <div class="w-full">
            <%= render "shared/empty_alert",
                  title: "Mapa sem dados",
                  message: "Defina categorias planejadas para visualizar a distribuição do orçamento.",
                  tone: :info,
                  compact: true %>
          </div>
        </div>
      <% end %>
    </div>
  </article>
</section>
