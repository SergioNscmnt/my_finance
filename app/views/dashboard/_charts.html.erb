<% data = local_assigns[:data] || @dashboard_data %>
<% income_series = Array(data[:chart_income]) %>
<% expense_series = Array(data[:chart_expense]) %>
<% balance_series = Array(data[:chart_balance]) %>
<% pie_series = Array(data[:pie_values]) %>
<% category_series = Array(data[:category_values]) %>
<% flow_has_data = income_series.any?(&:positive?) || expense_series.any?(&:positive?) || balance_series.any? { |value| value.to_f != 0 } %>
<% pie_has_data = pie_series.any?(&:positive?) %>
<% top_categories_has_data = category_series.any?(&:positive?) %>
<% flow_total_income = income_series.sum.to_f %>
<% flow_total_expense = expense_series.sum.to_f %>
<% flow_net = balance_series.present? ? balance_series.last.to_f : flow_total_income - flow_total_expense %>
<section class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
  <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <h3 class="flex items-center gap-2 text-sm font-semibold leading-none text-slate-900 dark:text-slate-100">
        <span class="text-blue-600 dark:text-blue-300"><%= icon_svg("chart-line") %></span>
        Fluxo mensal
      </h3>
      <%= form_with url: dashboard_path, method: :get, local: true, class: "flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400" do %>
        <label for="months" class="font-medium whitespace-nowrap">Período</label>
        <%= select_tag :months,
              options_for_select([["1 mês",1],["3 meses",3],["6 meses",6],["9 meses",9],["1 ano",12],["2 anos",24],["3 anos",36]], data[:chart_months]),
              class: "slim-select w-28 rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 bg-white focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400",
              data: { no_tom_select: true },
              onchange: "this.form.submit()" %>
      <% end %>
    </div>
    <div class="mb-3 grid grid-cols-1 gap-2 text-xs sm:grid-cols-3">
      <div class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400"><%= icon_svg("arrow-down-left", class_name: "h-3.5 w-3.5 shrink-0") %> Receitas</p>
        <p class="mt-0.5 font-semibold text-emerald-700 dark:text-emerald-400 tabular-nums" data-privacy-target="value"><%= number_to_currency(flow_total_income) %></p>
      </div>
      <div class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400"><%= icon_svg("arrow-up-right", class_name: "h-3.5 w-3.5 shrink-0") %> Despesas</p>
        <p class="mt-0.5 font-semibold text-amber-700 dark:text-amber-400 tabular-nums" data-privacy-target="value"><%= number_to_currency(flow_total_expense) %></p>
      </div>
      <div class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-2 dark:border-slate-700 dark:bg-slate-800/50">
        <p class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400"><%= icon_svg("wallet", class_name: "h-3.5 w-3.5 shrink-0") %> Saldo</p>
        <p class="mt-0.5 font-semibold tabular-nums <%= flow_net.negative? ? 'text-red-600 dark:text-red-400' : 'text-emerald-700 dark:text-emerald-400' %>" data-privacy-target="value"><%= number_to_currency(flow_net) %></p>
      </div>
    </div>
    <div class="h-60">
      <% if flow_has_data %>
        <canvas
          data-controller="chart"
          data-chart-type-value="line"
          data-chart-labels-value="<%= data[:chart_labels].to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Receitas", data: data[:chart_income], borderColor: "#10b981", backgroundColor: "rgba(16,185,129,0.15)", tension: 0.3, fill: true },
            { label: "Despesas", data: data[:chart_expense], borderColor: "#f59e0b", backgroundColor: "rgba(245,158,11,0.15)", tension: 0.3, fill: true },
            { label: "Saldo acumulado", data: data[:chart_balance], borderColor: "#2563eb", backgroundColor: "rgba(37,99,235,0.12)", tension: 0.3, fill: false }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      <% else %>
        <div class="flex h-full items-center">
          <%= render "shared/empty_alert",
                title: "Fluxo mensal sem dados",
                message: "Adicione transações para visualizar receitas e despesas no período selecionado.",
                tone: :info,
                compact: true %>
        </div>
      <% end %>
    </div>
  </article>

  <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="flex items-start justify-between gap-2 mb-3">
      <h3 class="flex items-center gap-2 text-sm font-semibold leading-none text-slate-900 dark:text-slate-100">
        <span class="text-sky-600 dark:text-sky-300"><%= icon_svg("pie-chart") %></span>
        Composição
      </h3>
      <span class="text-xs text-slate-500 dark:text-slate-400">Receita vs Despesa</span>
    </div>
    <div class="h-60">
      <% if pie_has_data %>
        <canvas
          data-controller="chart"
          data-chart-type-value="doughnut"
          data-chart-labels-value="<%= data[:pie_labels].to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Composição", data: data[:pie_values], backgroundColor: ["#10b981", "#f59e0b"] }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      <% else %>
        <div class="flex h-full items-center justify-center">
          <%= render "shared/empty_alert",
                title: "Composição sem dados",
                message: "Este gráfico será exibido assim que houver movimentação financeira.",
                tone: :info,
                compact: true %>
        </div>
      <% end %>
    </div>
  </article>

  <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="flex items-start justify-between gap-2 mb-3">
      <h3 class="flex items-center gap-2 text-sm font-semibold leading-none text-slate-900 dark:text-slate-100">
        <span class="text-amber-600 dark:text-amber-300"><%= icon_svg("tag") %></span>
        Top despesas
      </h3>
      <div class="flex flex-wrap items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
        <span class="text-slate-500 dark:text-slate-400">por categoria</span>
        <% categories = data[:category_options] || @category_options || [] %>
        <% selected_category = data[:category_filter] || @category_filter %>
        <%= form_with url: dashboard_path, method: :get, local: true, class: "flex items-center gap-2" do %>
          <%= hidden_field_tag :months, params[:months] if params[:months].present? %>
          <%= select_tag :category,
                options_for_select([["Todas", ""]] + categories.map { |c| [c, c] }, selected_category),
                include_blank: false,
                class: "slim-select w-40 rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 bg-white focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400",
                data: { no_tom_select: true },
                onchange: "this.form.requestSubmit()" %>
        <% end %>
      </div>
    </div>
    <div class="h-60">
      <% if top_categories_has_data %>
        <canvas
          data-controller="chart"
          data-chart-type-value="bar"
          data-chart-axis-value="y"
          data-chart-labels-value="<%= data[:category_labels].to_json %>"
          data-chart-datasets-value='<%= [
            { label: "Despesa", data: data[:category_values], backgroundColor: "#f59e0b" }
          ].to_json %>'
          data-privacy-target="value">
        </canvas>
      <% else %>
        <div class="flex h-full items-center">
          <%= render "shared/empty_alert",
                title: "Top despesas sem dados",
                message: "Sem despesas no período para montar o ranking por categoria.",
                tone: :warning,
                compact: true %>
        </div>
      <% end %>
    </div>
  </article>
</section>
