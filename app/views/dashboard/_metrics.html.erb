<% data = local_assigns[:data] || @dashboard_data %>
<% receita_total = data[:receita_total] || 0 %>
<% despesa_total = data[:despesa_total] || 0 %>
<% balance = data[:balance] || 0 %>
<% monthly_change = data[:monthly_change] %>
<% goals_count = data[:goals_count] || 0 %>

<section class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
  <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-sm text-slate-500">Receitas</p>
    <p class="mt-2 text-2xl font-semibold text-slate-900"><span data-privacy-target="value"><%= number_to_currency(receita_total) %></span></p>
    <span class="mt-3 inline-flex rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">Entradas</span>
  </article>
  <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-sm text-slate-500">Despesas</p>
    <p class="mt-2 text-2xl font-semibold text-slate-900"><span data-privacy-target="value"><%= number_to_currency(despesa_total) %></span></p>
    <span class="mt-3 inline-flex rounded-full bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700">Saídas</span>
  </article>
  <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-sm text-slate-500">Metas ativas</p>
    <p class="mt-2 text-2xl font-semibold text-slate-900"><span data-privacy-target="value"><%= goals_count %></span></p>
    <span class="mt-3 inline-flex rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700">Metas</span>
  </article>
  <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-sm text-slate-500">Saldo estimado</p>
    <p class="mt-2 text-2xl font-semibold text-slate-900"><span data-privacy-target="value"><%= number_to_currency(balance) %></span></p>
    <span class="mt-3 inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">Projetado</span>
    <% if monthly_change.present? %>
      <p class="text-xs mt-2 <%= monthly_change >= 0 ? 'text-emerald-700' : 'text-amber-700' %>">
        <span data-privacy-target="value"><%= monthly_change >= 0 ? '▲' : '▼' %> <%= number_to_currency(monthly_change) %></span> vs mês anterior
      </p>
    <% end %>
  </article>
</section>
