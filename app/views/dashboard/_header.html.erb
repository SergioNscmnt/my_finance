<% data = local_assigns[:data] || {} %>
<% balance = data[:balance] || @balance || 0 %>
<% monthly_change = data[:monthly_change] || @monthly_change %>
<% due_soon_invoices = data[:credit_card_due_soon_invoices] || @credit_card_due_soon_invoices || [] %>
<% current_month_invoices = data[:current_month_credit_card_invoices] || @current_month_credit_card_invoices || [] %>

<section class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:flex-wrap">
  <div class="flex flex-col gap-2">
    <p class="text-sm text-slate-600 dark:text-slate-400">Olá, <span class="font-semibold text-slate-900 dark:text-slate-100"><%= current_user.name %></span></p>
    <div class="flex items-center gap-2">
      <div>
        <p class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
          <span class="text-slate-500 dark:text-slate-400"><%= icon_svg("wallet") %></span>
          Saldo do mês
        </p>
        <div class="flex items-center gap-2">
          <p class="text-3xl font-semibold text-slate-900 dark:text-slate-100">
            <span data-privacy-target="value"><%= number_to_currency(balance) %></span>
          </p>
          <button type="button"
                  class="inline-flex items-center rounded-md border border-slate-200 bg-white px-2 py-1 text-xs font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50 focus:outline focus:outline-2 focus:outline-emerald-400 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-slate-500 dark:hover:bg-slate-800"
                  data-action="privacy#toggle"
                  data-privacy-target="trigger">
            <svg data-privacy-target="iconShow" xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <svg data-privacy-target="iconHide" xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M3 3l18 18"/>
              <path d="M10.6 10.6A3 3 0 0 0 12 15a3 3 0 0 0 3.4-3.4M9.88 4.24A9.8 9.8 0 0 1 12 4c7 0 11 8 11 8a15.6 15.6 0 0 1-3.18 4.36m-2.24 1.77A10 10 0 0 1 12 20c-7 0-11-8-11-8a15.6 15.6 0 0 1 4.35-5.36"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <% if monthly_change.present? %>
      <p class="text-sm <%= monthly_change >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
        <span data-privacy-target="value"><%= monthly_change >= 0 ? '+' : '' %><%= number_to_currency(monthly_change) %></span> vs mês anterior
      </p>
    <% end %>
  </div>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
    <div class="relative">
      <details class="group" data-controller="dropdown">
        <summary class="dropdown-summary list-none inline-flex items-center justify-center gap-2 rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700 focus:outline focus:outline-2 focus:outline-emerald-400 cursor-pointer w-full sm:w-auto">
          Nova +
        </summary>
        <div class="dropdown-menu absolute left-0 mt-1 w-full sm:w-48 shadow-lg z-10 lg:left-auto lg:right-0">
          <%= link_to "Receita", new_transaction_path(type: :income), data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "dropdown-option" %>
          <%= link_to "Despesa", new_transaction_path(type: :expense), data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "dropdown-option" %>
        </div>
      </details>
    </div>
    <%= link_to "Importar CSV", import_transactions_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center justify-center gap-2 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-blue-700 focus:outline focus:outline-2 focus:outline-blue-400 w-full sm:w-auto" rescue nil %>
  </div>
</section>

<% if due_soon_invoices.any? || current_month_invoices.any? %>
  <section class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
    <article class="rounded-xl border border-amber-200 bg-amber-50 p-4 shadow-sm dark:border-amber-900/70 dark:bg-amber-900/20">
      <div class="mb-2 flex items-center justify-between gap-3">
        <h3 class="flex items-center gap-2 text-sm font-semibold text-amber-800 dark:text-amber-200">
          <%= icon_svg("alert-triangle") %>
          Alertas de vencimento
        </h3>
        <span class="text-xs font-medium text-amber-700 dark:text-amber-300"><%= due_soon_invoices.size %> alerta(s)</span>
      </div>
      <% if due_soon_invoices.any? %>
        <div class="space-y-2">
          <% due_soon_invoices.each do |invoice| %>
            <% days_left = (invoice.due_on - Date.current).to_i %>
            <% due_badge_class = days_left.negative? ? "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300" : (days_left.zero? ? "bg-amber-200 text-amber-900 dark:bg-amber-900/40 dark:text-amber-200" : "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300") %>
            <% due_label = days_left.negative? ? "Atrasada #{days_left.abs}d" : (days_left.zero? ? "Vence hoje" : "Vence em #{days_left}d") %>
            <div class="rounded-lg border border-amber-200 bg-white/70 px-3 py-2 dark:border-amber-900/70 dark:bg-slate-900/40">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="min-w-0">
                  <p class="flex items-center gap-2 text-sm font-semibold text-amber-900 dark:text-amber-200">
                    <%= category_icon(invoice.category, class_name: "h-4 w-4 shrink-0") %>
                    <%= invoice.category.name %>
                  </p>
                  <p class="text-xs text-amber-800/90 dark:text-amber-300">
                    Vencimento: <strong><%= l(invoice.due_on, format: :default) %></strong> ·
                    Valor: <strong data-privacy-target="value"><%= number_to_currency(invoice.total_amount) %></strong>
                  </p>
                </div>
                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold <%= due_badge_class %>"><%= due_label %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-amber-800 dark:text-amber-200">Nenhuma fatura vencendo nos próximos 5 dias.</p>
      <% end %>
    </article>

    <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
      <div class="mb-2 flex items-center justify-between gap-3">
        <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-100">
          <span class="text-blue-600 dark:text-blue-300"><%= icon_svg("credit-card") %></span>
          Fatura do mês atual
        </h3>
        <span class="text-xs text-slate-500 dark:text-slate-400"><%= current_month_invoices.size %> cartão(ões)</span>
      </div>
      <% if current_month_invoices.any? %>
        <div class="space-y-2">
          <% current_month_invoices.each do |invoice| %>
            <div class="rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-700">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="flex items-center gap-2 text-sm font-medium text-slate-900 dark:text-slate-100">
                    <%= category_icon(invoice.category, class_name: "h-4 w-4 shrink-0") %>
                    <%= invoice.category.name %>
                  </p>
                  <p class="text-xs text-slate-500 dark:text-slate-400">
                    Vencimento: <%= l(invoice.due_on, format: :default) %>
                  </p>
                </div>
                <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 tabular-nums" data-privacy-target="value"><%= number_to_currency(invoice.total_amount) %></p>
              </div>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
                <% if invoice.paid? %>
                  <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-200">Pago</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-900/30 dark:text-amber-200">
                    <%= invoice.overdue? ? "Em atraso" : "Aberta" %>
                  </span>
                  <%= link_to "Marcar como pago",
                        pay_credit_card_invoice_path(invoice),
                        data: { turbo_method: :patch, turbo_confirm: "Confirmar pagamento da fatura?" },
                        class: "rounded-md border border-emerald-200 px-3 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-50 dark:border-emerald-900/70 dark:text-emerald-300 dark:hover:bg-emerald-900/20" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 dark:text-slate-400">Nenhuma fatura gerada para o mês atual.</p>
      <% end %>
    </article>
  </section>
<% end %>
