<!-- Dashboard MyFinance: visão geral com ações e estado vazio -->
<div class="min-h-screen bg-slate-50 text-slate-900">
  <header class="sticky top-0 z-30 bg-white shadow-sm">
    <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
      <div class="flex items-center gap-2">
        <div class="h-10 w-10 rounded-lg bg-blue-600 text-white grid place-items-center font-semibold">MF</div>
        <div>
          <p class="text-xs text-slate-500">Plataforma</p>
          <p class="font-semibold text-slate-900">MyFinance</p>
        </div>
      </div>
      <nav class="ml-auto flex items-center gap-2">
        <%= link_to "Dashboard", dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 focus:outline focus:outline-2 focus:outline-blue-400" %>
        <%= link_to "Metas", goals_path, class: "px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline focus:outline-2 focus:outline-blue-400" rescue nil %>
        <%= link_to "Transações", transactions_path, class: "px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline focus:outline-2 focus:outline-blue-400" %>
        <%= link_to "Categorias", categories_path, class: "px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline focus:outline-2 focus:outline-blue-400" %>
        <%= link_to "Sair", session_path, data: { turbo_method: :delete }, class: "px-3 py-2 rounded-md text-sm font-medium text-red-50 bg-red-600 hover:bg-red-700 focus:outline focus:outline-2 focus:outline-red-400" %>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 py-6 space-y-6">
    <!-- Saldo e ações principais -->
    <section class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-sm text-slate-500">Saldo do mês</p>
        <p class="text-3xl font-semibold text-slate-900"><%= number_to_currency(@balance || 0) %></p>
        <% if defined?(@monthly_change) && @monthly_change.present? %>
          <p class="text-sm <%= @monthly_change >= 0 ? 'text-emerald-700' : 'text-red-700' %> mt-1">
            <%= @monthly_change >= 0 ? '+' : '' %><%= number_to_currency(@monthly_change) %> vs mês anterior
          </p>
        <% end %>
      </div>
      <div class="flex flex-wrap gap-2">
        <!-- Botão positivo (adicionar receita) -->
        <%= link_to "Adicionar receita", new_transaction_path(type: :income), class: "inline-flex items-center gap-2 rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700 focus:outline focus:outline-2 focus:outline-emerald-400" %>
        <!-- Botão alerta para despesa -->
        <%= link_to "Adicionar despesa", new_transaction_path(type: :expense), class: "inline-flex items-center gap-2 rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-amber-600 focus:outline focus:outline-2 focus:outline-amber-300" %>
        <!-- Botão informativo -->
        <%= link_to "Importar CSV", import_transactions_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center gap-2 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-blue-700 focus:outline focus:outline-2 focus:outline-blue-400" rescue nil %>
      </div>
    </section>

    <!-- KPIs -->
    <% receita_total = (@receita_total || 0) %>
    <% despesa_total = (@despesa_total || 0) %>
    <% goals_count = (@goals_count || 0) %>
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-sm text-slate-500">Receitas</p>
        <p class="mt-2 text-2xl font-semibold text-slate-900"><%= number_to_currency(receita_total) %></p>
        <span class="mt-3 inline-flex rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">Entradas</span>
      </article>
      <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-sm text-slate-500">Despesas</p>
        <p class="mt-2 text-2xl font-semibold text-slate-900"><%= number_to_currency(despesa_total) %></p>
        <span class="mt-3 inline-flex rounded-full bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700">Saídas</span>
      </article>
      <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-sm text-slate-500">Metas ativas</p>
        <p class="mt-2 text-2xl font-semibold text-slate-900"><%= goals_count %></p>
        <span class="mt-3 inline-flex rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700">Metas</span>
      </article>
      <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-sm text-slate-500">Saldo estimado</p>
        <p class="mt-2 text-2xl font-semibold text-slate-900"><%= number_to_currency(receita_total - despesa_total) %></p>
        <span class="mt-3 inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">Projetado</span>
      </article>
    </section>

    <!-- Filtros com Turbo para não recarregar a página -->
    <section class="flex flex-wrap items-center gap-3">
      <span class="text-sm text-slate-600">Filtrar por período:</span>
      <turbo-frame id="filters">
        <%= form_with url: transactions_path, method: :get, data: { turbo_frame: "transactions" }, class: "flex flex-wrap gap-2 items-center" do |f| %>
          <%= f.date_field :from, class: "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
          <span class="text-slate-500 text-sm">até</span>
          <%= f.date_field :to, class: "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
          <%= f.submit "Aplicar", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 focus:outline focus:outline-2 focus:outline-blue-400" %>
        <% end %>
      </turbo-frame>
    </section>

    <!-- Lista de transações ou estado vazio -->
    <turbo-frame id="transactions">
      <% if @transactions.present? %>
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
            <p class="font-semibold text-slate-900">Transações recentes</p>
            <span class="text-sm text-slate-500">Últimos 30 dias</span>
          </header>
          <div class="divide-y divide-slate-100">
            <% @transactions.each do |t| %>
              <article class="flex items-center gap-4 px-4 py-3">
                <div class="flex-1">
                  <p class="font-medium text-slate-900"><%= t.title %></p>
                  <p class="text-sm text-slate-500"><%= t.category %> · <%= l(t.date) %></p>
                </div>
                <p class="text-sm font-semibold <%= t.income? ? 'text-emerald-700' : 'text-amber-700' %>">
                  <%= t.income? ? '+' : '-' %> <%= number_to_currency(t.amount) %>
                </p>
                <div class="flex items-center gap-2">
                  <%= link_to "Editar", edit_transaction_path(t), class: "rounded-md bg-blue-50 px-3 py-1.5 text-sm font-medium text-blue-700 hover:bg-blue-100 focus:outline focus:outline-2 focus:outline-blue-400" %>
                  <%= button_to "Excluir", transaction_path(t), method: :delete, data: { turbo_confirm: "Excluir esta transação?" }, class: "rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 focus:outline focus:outline-2 focus:outline-red-400" %>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% else %>
        <!-- Estado vazio com CTA -->
        <section class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center shadow-sm">
          <p class="text-lg font-semibold text-slate-900">Nenhuma transação encontrada</p>
          <p class="mt-2 text-sm text-slate-600">Adicione receitas ou despesas para começar a acompanhar seu fluxo.</p>
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            <%= link_to "Adicionar receita", new_transaction_path(type: :income), class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 focus:outline focus:outline-2 focus:outline-emerald-400" %>
            <%= link_to "Adicionar despesa", new_transaction_path(type: :expense), class: "rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 focus:outline focus:outline-2 focus:outline-amber-300" %>
          </div>
        </section>
      <% end %>
    </turbo-frame>
  </main>
</div>
