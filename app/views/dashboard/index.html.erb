<!-- Dashboard MyFinance: visão geral com ações e estado vazio -->
<div class="min-h-screen bg-slate-50 text-slate-900">
  <main class="mx-auto max-w-6xl px-4 py-6 space-y-6" data-controller="privacy">
    <!-- Saldo e ações principais -->
    <div id="dashboard-header">
      <%= render "dashboard/header", data: { balance: @balance, monthly_change: @monthly_change } %>
    </div>

    <div id="dashboard-metrics">
      <%= render "dashboard/metrics", data: {
        receita_total: @receita_total, despesa_total: @despesa_total,
        balance: @balance, monthly_change: @monthly_change,
        goals_count: @goals_count
      } %>
    </div>

    <div id="dashboard-charts">
      <%= render "dashboard/charts", data: {
        chart_months: @chart_months,
        chart_labels: @chart_labels,
        chart_income: @chart_income,
        chart_expense: @chart_expense,
        pie_labels: @pie_labels,
        pie_values: @pie_values,
        category_labels: @category_labels,
        category_values: @category_values
      } %>
    </div>

    <!-- Filtros com Turbo para não recarregar a página -->
    <section class="overflow-x-auto">
      <turbo-frame id="filters">
        <%= form_with url: transactions_path, method: :get, data: { turbo_frame: "transactions" }, class: "grid grid-cols-1 gap-2 md:flex md:items-center md:gap-3 md:flex-wrap" do |f| %>
          <div class="flex flex-col text-sm text-slate-600 md:w-auto">
            <span>Filtrar por período e tipo:</span>
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-2">
              <%= f.date_field :from, class: "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none w-full md:w-auto" %>
              <span class="text-slate-500 text-sm md:w-auto w-full">até</span>
              <%= f.date_field :to, class: "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none w-full md:w-auto" %>
              <%= select_tag :type,
                    options_for_select([["Todos", ""], ["Receitas", "income"], ["Despesas", "expense"]], params[:type]),
                    class: "rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 bg-white focus:border-blue-500 focus:outline-none w-full md:w-auto" %>
            </div>
          </div>
          <%= f.submit "Aplicar", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 focus:outline focus:outline-2 focus:outline-blue-400 w-full md:w-auto" %>
        <% end %>
      </turbo-frame>
    </section>

    <!-- Lista de transações -->
    <turbo-frame id="transactions">
      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
          <p class="font-semibold text-slate-900">Transações recentes</p>
          <span class="text-sm text-slate-500">Últimos 30 dias</span>
        </header>
        <div id="dashboard_transactions" class="divide-y divide-slate-100">
          <% @transactions.each do |t| %>
            <%= render "transactions/dashboard_transaction", t: t %>
          <% end %>
        </div>
      </section>
    </turbo-frame>
  </main>
</div>
