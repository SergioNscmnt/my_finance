<!-- Dashboard MyFinance: visão geral com ações e estado vazio -->
<div class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
  <main class="mx-auto max-w-6xl px-4 py-6 space-y-6" data-controller="privacy">
    <!-- Saldo e ações principais -->
    <div id="dashboard-header">
      <%= render "dashboard/header", data: { balance: @balance, monthly_change: @monthly_change } %>
    </div>

    <div id="dashboard-metrics">
      <%= render "dashboard/metrics", data: {
        receita_total: @receita_total, despesa_total: @despesa_total,
        balance: @balance, monthly_change: @monthly_change,
        goals_count: @goals_count
      } %>
    </div>

    <div id="dashboard-charts">
      <%= render "dashboard/charts", data: {
        chart_months: @chart_months,
        chart_labels: @chart_labels,
        chart_income: @chart_income,
        chart_expense: @chart_expense,
        pie_labels: @pie_labels,
        pie_values: @pie_values,
        category_labels: @category_labels,
        category_values: @category_values
      } %>
    </div>

    <div id="dashboard-budget-planner">
      <%= render "dashboard/budget_planner",
            category_budget: @category_budget,
            budget_categories: @budget_categories,
            category_budgets: @category_budgets,
            balance: @balance,
            planned_budget_total: @planned_budget_total,
            available_after_budget: @available_after_budget,
            budget_labels: @budget_labels,
            budget_values: @budget_values %>
    </div>

    <!-- Filtros com Turbo para não recarregar a página -->
    <section class="overflow-x-auto">
      <turbo-frame id="filters">
        <%= form_with url: dashboard_path, method: :get, data: { turbo_frame: "dashboard_transactions" }, class: "grid grid-cols-1 gap-2 md:flex md:items-start md:gap-3 md:flex-wrap" do |f| %>
          <div class="flex flex-col text-sm text-slate-600 md:w-auto dark:text-slate-400">
            <span class="mb-1">Filtrar por período e tipo:</span>
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-2">
              <span class="text-slate-500 text-sm md:w-auto w-full md:mt-0 dark:text-slate-400">De</span>
              <%= f.date_field :from,
                    class: "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none w-full md:w-auto",
                    value: @list_from&.strftime("%Y-%m-%d"),
                    data: { controller: "datepicker", "datepicker-alt-format-value": "d/m/Y", "datepicker-date-format-value": "Y-m-d" } %>
              <span class="text-slate-500 text-sm md:w-auto w-full dark:text-slate-400">até</span>
              <%= f.date_field :to,
                    class: "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none w-full md:w-auto",
                    value: @list_to&.strftime("%Y-%m-%d"),
                    data: { controller: "datepicker", "datepicker-alt-format-value": "d/m/Y", "datepicker-date-format-value": "Y-m-d" } %>
              <%= select_tag :type,
                    options_for_select([["Todos", ""], ["Receitas", "income"], ["Despesas", "expense"]], params[:type]),
                    class: "rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 bg-white focus:border-blue-500 focus:outline-none w-full md:w-auto dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400" %>
            </div>
          </div>
          <%= f.submit "Aplicar", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 focus:outline focus:outline-2 focus:outline-blue-400 w-full md:w-auto md:self-end" %>
        <% end %>
      </turbo-frame>
    </section>

    <!-- Lista de transações -->
    <turbo-frame id="dashboard_transactions">
      <%= render "dashboard/transactions", transactions_grouped: @transactions_grouped, list_label: @list_label %>
    </turbo-frame>
  </main>
</div>
