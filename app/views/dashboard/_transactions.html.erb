<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
  <% grouped_items = transactions_grouped.present? ? transactions_grouped.to_h : {} %>
  <% month_scope = params[:month_scope] == "future" ? "future" : "past" %>
  <% past_month_pages = (0..11).map { |offset| Date.current.beginning_of_month - offset.months } %>
  <% future_month_pages = (1..12).map { |offset| Date.current.beginning_of_month + offset.months } %>
  <% month_pages = month_scope == "future" ? future_month_pages : past_month_pages %>
  <% selected_page = params[:month_page].to_i %>
  <% selected_page = 1 unless selected_page.between?(1, 12) %>
  <% selected_month = month_pages[selected_page - 1] %>
  <% selected_entries = grouped_items[selected_month] || [] %>
  <% nav_params = params.permit(:months, :category, :month_page, :month_scope).to_h %>

  <header class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
    <p class="font-semibold text-slate-900 dark:text-slate-100">Transações do mês</p>
    <div class="flex items-center gap-2">
      <%= link_to "Atuais/anteriores",
                  dashboard_path(nav_params.merge(month_scope: "past", month_page: 1)),
                  class: month_scope == "past" ? "inline-flex rounded-md bg-blue-600 px-2 py-1 text-xs font-semibold text-white" : "inline-flex rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700",
                  data: { turbo_frame: "dashboard_transactions" } %>
      <%= link_to "Futuras",
                  dashboard_path(nav_params.merge(month_scope: "future", month_page: 1)),
                  class: month_scope == "future" ? "inline-flex rounded-md bg-blue-600 px-2 py-1 text-xs font-semibold text-white" : "inline-flex rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700",
                  data: { turbo_frame: "dashboard_transactions" } %>
      <span class="text-sm text-slate-500 dark:text-slate-400"><%= l(selected_month, format: "%B %Y") %></span>
    </div>
  </header>

  <% scroll_class = selected_entries.size > 5 ? "max-h-[520px] overflow-y-auto" : "" %>
  <div id="dashboard_transactions_list" class="<%= [scroll_class, "divide-y divide-slate-100 dark:divide-slate-800"].reject(&:blank?).join(" ") %>">
    <% if selected_entries.blank? %>
      <div class="px-4 py-6">
        <%= render "shared/empty_alert",
              title: month_scope == "future" ? "Sem transações futuras no mês" : "Sem transações no período",
              message: month_scope == "future" ? "Quando houver lançamentos futuros, eles aparecerão aqui." : "Este card será preenchido conforme você registrar receitas e despesas.",
              tone: :info %>
      </div>
    <% else %>
      <% selected_entries.each do |entry| %>
        <%= render "transactions/dashboard_transaction", t: entry[:transaction], reference_month: entry[:month] %>
      <% end %>
    <% end %>
  </div>

  <footer class="border-t border-slate-200 px-4 py-3 dark:border-slate-700">
    <nav class="flex flex-wrap items-center gap-2" aria-label="Paginação por mês">
      <% (1..12).each do |page_number| %>
        <% active = page_number == selected_page %>
        <% link_classes = active ? "inline-flex h-8 min-w-8 items-center justify-center rounded-md bg-blue-600 px-2 text-xs font-semibold text-white" : "inline-flex h-8 min-w-8 items-center justify-center rounded-md bg-slate-100 px-2 text-xs font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" %>
        <%= link_to page_number,
                    dashboard_path(nav_params.merge(month_page: page_number)),
                    class: link_classes,
                    data: { turbo_frame: "dashboard_transactions" } %>
      <% end %>
    </nav>
  </footer>
</section>
