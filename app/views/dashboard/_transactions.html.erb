<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
  <header class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
    <p class="font-semibold text-slate-900 dark:text-slate-100">Transações do mês</p>
    <span class="text-sm text-slate-500 dark:text-slate-400"><%= list_label %></span>
  </header>

  <% grouped_items = transactions_grouped.present? ? transactions_grouped.to_h : {} %>
  <% total_items = grouped_items.values.sum { |items| items.size } %>
  <% scroll_class = total_items > 5 ? "max-h-[520px] overflow-y-auto" : "" %>
  <div id="dashboard_transactions_list" class="<%= [scroll_class, "divide-y divide-slate-100 dark:divide-slate-800"].reject(&:blank?).join(" ") %>">
    <% if grouped_items.blank? %>
      <div class="px-4 py-6">
        <%= render "shared/empty_alert",
              title: "Sem transações no período",
              message: "Este card será preenchido conforme você registrar receitas e despesas.",
              tone: :info %>
      </div>
    <% else %>
      <% grouped_items.each do |month, month_entries| %>
        <div class="sticky top-0 z-10 bg-slate-50 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600 dark:bg-slate-900 dark:text-slate-300">
          <%= l(month, format: "%B %Y") %>
        </div>
        <% month_entries.each do |entry| %>
          <%= render "transactions/dashboard_transaction", t: entry[:transaction], reference_month: entry[:month] %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
