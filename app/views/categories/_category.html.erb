<tr id="<%= dom_id(category) %>" class="hover:bg-slate-50 dark:hover:bg-slate-800">
  <td class="px-4 py-3 text-sm font-medium text-slate-900 dark:text-slate-100">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-2">
        <%= category_icon(category, class_name: "h-4 w-4 shrink-0 text-slate-500 dark:text-slate-400") %>
        <%= category.name %>
      </span>
      <% if category.credit_card? %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700 dark:bg-blue-900/30 dark:text-blue-200">
          <%= icon_svg("credit-card", class_name: "h-3.5 w-3.5 shrink-0") %>
          <%= category.card_bank.presence || "Cartão" %> | fecha <%= category.statement_closing_day %> | vence <%= category.statement_due_day %>
        </span>
      <% end %>
    </div>
  </td>
  <% is_expense = category.kind.to_sym == :expense %>
  <% kind_label = is_expense ? "Despesa" : "Receita" %>
  <% badge_classes = is_expense ? "bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-900/40 dark:text-amber-200 dark:border-amber-900" : "bg-emerald-100 text-emerald-800 border border-emerald-200 dark:bg-emerald-900/40 dark:text-emerald-200 dark:border-emerald-900" %>
  <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-200">
    <span
      class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold leading-5 <%= badge_classes %>"
      title="<%= kind_label %>"
      aria-label="Tipo da categoria: <%= kind_label %>"
    >
      <%= icon_svg(is_expense ? "arrow-up-right" : "arrow-down-left", class_name: "h-3.5 w-3.5 shrink-0") %>
      <span class="uppercase tracking-wide"><%= kind_label %></span>
    </span>
  </td>
  <td class="px-4 py-3 text-sm text-right">
    <div class="flex w-full justify-end gap-2">
      <%= link_to "Editar", edit_category_path(category), data: { turbo_frame: "modal" }, class: "rounded-md bg-blue-50 px-3 py-1.5 font-medium text-blue-700 hover:bg-blue-100 focus:outline focus:outline-2 focus:outline-blue-400 dark:bg-blue-900/30 dark:text-blue-200 dark:hover:bg-blue-900/50" %>
      <%= link_to "Excluir", category_path(category), data: { turbo_method: :delete, turbo_confirm: "Remover?" }, class: "rounded-md bg-red-600 px-3 py-1.5 font-medium text-white hover:bg-red-700 focus:outline focus:outline-2 focus:outline-red-400" %>
    </div>
  </td>
</tr>
