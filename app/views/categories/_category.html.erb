<tr id="<%= dom_id(category) %>" class="hover:bg-slate-50">
  <td class="px-4 py-3 text-sm font-medium text-slate-900"><%= category.name %></td>
  <td class="px-4 py-3 text-sm text-slate-700"><%= category.kind.humanize %></td>
  <td class="px-4 py-3 text-sm text-right space-x-2">
    <%= link_to "Editar", edit_category_path(category), data: { turbo_frame: "category_form" }, class: "rounded-md bg-blue-50 px-3 py-1.5 font-medium text-blue-700 hover:bg-blue-100 focus:outline focus:outline-2 focus:outline-blue-400" %>
    <%= link_to "Excluir", category_path(category), data: { turbo_method: :delete, turbo_confirm: "Remover?" }, class: "rounded-md bg-red-600 px-3 py-1.5 font-medium text-white hover:bg-red-700 focus:outline focus:outline-2 focus:outline-red-400" %>
  </td>
</tr>
