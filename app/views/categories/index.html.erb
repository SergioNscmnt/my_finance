<div class="max-w-4xl mx-auto px-4 py-6 space-y-6">
  <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Categorias</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">Organize receitas e despesas por categorias.</p>
    </div>
    <div class="flex items-center justify-end gap-2 w-full sm:w-auto">
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200"><%= @pagy&.count || @categories.count %> categorias</span>
      <%= link_to "Nova categoria", new_category_path, data: { turbo_frame: "modal" }, class: "hidden sm:inline-flex rounded-md border border-blue-600 px-4 py-2 text-sm font-semibold text-blue-600 hover:bg-blue-50 focus:outline focus:outline-2 focus:outline-blue-400 dark:border-blue-300 dark:text-blue-200 dark:hover:bg-blue-900/20" %>
      <%= link_to new_category_path, data: { turbo_frame: "modal" }, class: "inline-flex sm:hidden h-10 w-10 items-center justify-center rounded-full border border-blue-600 text-blue-600 hover:bg-blue-50 focus:outline focus:outline-2 focus:outline-blue-400 dark:border-blue-300 dark:text-blue-200 dark:hover:bg-blue-900/20", aria: { label: "Nova categoria" } do %>
        <span class="text-lg leading-none">+</span>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "categories" do %>
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
      <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
        <p class="font-semibold text-slate-900 dark:text-slate-100">Lista de categorias</p>
      </header>
      <div class="md:hidden divide-y divide-slate-100 dark:divide-slate-800">
        <%= render partial: "category_card", collection: @categories, as: :category %>
      </div>
      <div class="hidden md:block overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-300">
            <tr>
              <th class="px-4 py-3">Nome</th>
              <th class="px-4 py-3">Tipo</th>
              <th class="px-4 py-3 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white dark:divide-slate-800 dark:bg-slate-900">
            <%= render @categories %>
          </tbody>
        </table>
      </div>
      <% if @pagy&.pages.to_i > 1 %>
        <div class="border-t border-slate-200 px-4 py-3 text-sm dark:border-slate-700">
          <%= pagy_nav(@pagy, link_extra: 'data-turbo-frame="categories"').html_safe %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
