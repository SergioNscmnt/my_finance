<div class="max-w-4xl mx-auto px-4 py-6 space-y-6">
  <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Categorias</h1>
      <p class="text-sm text-slate-600">Organize receitas e despesas por categorias.</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"><%= @categories.count %> categorias</span>
      <%= link_to "Nova categoria", new_category_path, data: { turbo_frame: "modal" }, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-blue-700 focus:outline focus:outline-2 focus:outline-blue-400" %>
    </div>
  </div>

  <%= turbo_frame_tag "category_form" do %>
    <%= render "form", category: @category %>
  <% end %>

  <%= turbo_frame_tag "categories" do %>
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
        <p class="font-semibold text-slate-900">Lista de categorias</p>
      </header>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
            <tr>
              <th class="px-4 py-3">Nome</th>
              <th class="px-4 py-3">Tipo</th>
              <th class="px-4 py-3 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <%= render @categories %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
