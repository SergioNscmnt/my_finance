<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
  <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
    <p class="font-semibold text-slate-900 dark:text-slate-100">Lista de categorias</p>
  </header>
  <div class="md:hidden divide-y divide-slate-100 dark:divide-slate-800">
    <% if categories.any? %>
      <%= render partial: "category_card", collection: categories, as: :category %>
    <% else %>
      <div class="p-4">
        <%= render "shared/empty_alert",
              title: "Nenhuma categoria cadastrada",
              message: "Use o botão \"Nova categoria\" para organizar receitas e despesas.",
              tone: :warning %>
      </div>
    <% end %>
  </div>
  <div class="hidden md:block overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-300">
        <tr>
          <th class="px-4 py-3">Nome</th>
          <th class="px-4 py-3">Tipo</th>
          <th class="px-4 py-3 text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white dark:divide-slate-800 dark:bg-slate-900">
        <% if categories.any? %>
          <%= render categories %>
        <% else %>
          <tr>
            <td colspan="3" class="px-4 py-4">
              <%= render "shared/empty_alert",
                    title: "Nenhuma categoria cadastrada",
                    message: "Use o botão \"Nova categoria\" para organizar receitas e despesas.",
                    tone: :warning %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if pagy&.pages.to_i > 1 %>
    <div class="border-t border-slate-200 px-4 py-3 text-sm dark:border-slate-700">
      <%= pagy_nav(pagy, link_extra: 'data-turbo-frame="categories"').html_safe %>
    </div>
  <% end %>
</section>
