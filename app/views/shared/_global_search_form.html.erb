<%= form_with url: search_path,
      method: :get,
      local: true,
      class: "relative w-full",
      data: {
        controller: "global-search",
        global_search_preview_url_value: search_preview_path
      } do |f| %>
  <div class="flex h-10 w-full items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-slate-800 shadow-sm transition focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus-within:border-sky-400 dark:focus-within:ring-sky-900/40">
    <span class="flex shrink-0 items-center text-slate-400 dark:text-slate-500">
      <%= icon_svg("search", class_name: "h-4 w-4 shrink-0") %>
    </span>
    <%= f.search_field :q,
          value: params[:q],
          placeholder: "Pesquisar transações, categorias, orçamentos...",
          autocomplete: "off",
          class: "global-search-input min-w-0 flex-1 bg-transparent text-sm text-slate-800 outline-none placeholder:text-slate-400 dark:text-slate-100 dark:placeholder:text-slate-500",
          data: {
            global_search_target: "input",
            action: "input->global-search#queue focus->global-search#queue keydown->global-search#handleKeydown"
          } %>
  </div>
  <div data-global-search-target="preview"
       class="absolute left-0 right-0 top-full z-50 mt-2 hidden overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900"></div>
<% end %>
