<section class="fixed bottom-5 right-5 z-40 hidden w-[320px] rounded-2xl border border-slate-200 bg-white p-3 shadow-xl lg:block dark:border-slate-700 dark:bg-slate-900"
         data-controller="ai-consultant"
         data-ai-consultant-url-value="<%= ai_consultant_path %>">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">Consultora IA</p>
      <p class="text-xs text-slate-500 dark:text-slate-400">Ollama local</p>
    </div>
    <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-200">Beta</span>
  </div>

  <div class="mt-3 h-40 space-y-2 overflow-y-auto rounded-xl border border-slate-200 bg-slate-50 p-2 text-xs dark:border-slate-700 dark:bg-slate-950"
       data-ai-consultant-target="messages">
    <div class="flex justify-start">
      <div class="max-w-[90%] rounded-xl bg-slate-100 px-3 py-2 text-xs text-slate-900 dark:bg-slate-800 dark:text-slate-100">
        Oi! Pergunte algo sobre seus gastos do mes.
      </div>
    </div>
  </div>

  <form class="mt-2 flex gap-2" data-action="submit->ai-consultant#submit" data-turbo="false">
    <textarea rows="2"
              class="flex-1 resize-none rounded-xl border border-slate-300 bg-white px-2 py-1.5 text-xs text-slate-900 focus:border-emerald-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
              placeholder="Ex: Onde estou gastando mais?"
              data-ai-consultant-target="input"></textarea>
    <button type="submit"
            class="rounded-xl bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700 focus:outline focus:outline-2 focus:outline-emerald-400"
            data-ai-consultant-target="submit">
      Enviar
    </button>
  </form>
  <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400" data-ai-consultant-target="status"></p>
</section>
