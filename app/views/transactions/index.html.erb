<div class="max-w-6xl mx-auto px-4 py-6 space-y-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Transações</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">Controle suas receitas e despesas rapidamente.</p>
    </div>
    <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
      <%= link_to "Importar PDF",
            import_statement_pdf_transactions_path,
            data: { turbo_frame: "modal" },
            class: "inline-flex items-center justify-center rounded-md border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100 dark:border-blue-900/60 dark:bg-blue-900/30 dark:text-blue-200 dark:hover:bg-blue-900/50" %>
      <div class="relative w-full sm:w-auto">
        <details class="group" data-controller="dropdown">
          <summary class="dropdown-summary list-none rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700 focus:outline focus:outline-2 focus:outline-emerald-400 cursor-pointer w-full sm:w-auto text-center">
            Nova +
          </summary>
          <div class="dropdown-menu absolute left-0 mt-1 w-full sm:w-48 shadow-lg z-10 lg:left-auto lg:right-0">
            <%= link_to "Receita", new_transaction_path(type: :income), data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "dropdown-option" %>
            <%= link_to "Despesa", new_transaction_path(type: :expense), data: { turbo_frame: "modal", action: "click->dropdown#close" }, class: "dropdown-option" %>
          </div>
        </details>
      </div>
    </div>
  </div>

  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <%= form_with url: transactions_path, method: :get, local: true, class: "grid grid-cols-1 gap-3 md:grid-cols-12 md:items-end" do |f| %>
      <div class="space-y-1 md:col-span-3">
        <label class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Tipo</label>
        <%= f.select :type,
              options_for_select([["Todos", ""], ["Receita", "income"], ["Despesa", "expense"]], params[:type]),
              {},
              class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400",
              data: { no_tom_select: true } %>
      </div>

      <div class="space-y-1 md:col-span-3">
        <label class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Título</label>
        <%= f.text_field :title,
              value: params[:title],
              placeholder: "Buscar por título",
              class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400" %>
      </div>

      <div class="space-y-1 md:col-span-3">
        <label class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Data</label>
        <%= f.text_field :on,
              value: params[:on],
              id: "flatpickr-date-filter",
              autocomplete: "off",
              placeholder: "DD-MM-YYYY",
              class: "input w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400" %>
      </div>

      <div class="space-y-1 md:col-span-3">
        <label class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Categoria</label>
        <%= f.select :category_id,
              options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
              { include_blank: "Todas" },
              class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-blue-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-sky-400",
              data: { no_tom_select: true } %>
      </div>

      <div class="flex items-end justify-end gap-2 md:col-span-12">
        <%= f.button type: :submit, aria: { label: "Filtrar" }, class: "inline-flex h-10 w-10 items-center justify-center rounded-md bg-blue-600 text-sm font-semibold text-white hover:bg-blue-700 focus:outline focus:outline-2 focus:outline-blue-400 md:w-auto md:px-4" do %>
          <svg class="h-5 w-5 md:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <span class="hidden md:inline">Filtrar</span>
        <% end %>

        <%= link_to transactions_path, aria: { label: "Limpar filtros" }, class: "inline-flex h-10 w-10 items-center justify-center rounded-md bg-slate-100 text-sm font-medium text-slate-700 hover:bg-slate-200 focus:outline focus:outline-2 focus:outline-slate-400 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 md:w-auto md:px-4" do %>
          <svg class="h-5 w-5 md:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m3 16 8.5-8.5a2 2 0 0 1 2.8 0L21 14.2a2 2 0 0 1 0 2.8L17 21H8.8a2 2 0 0 1-1.4-.6L3 16Z"></path>
            <path d="M14.5 10.5 8 17"></path>
          </svg>
          <span class="hidden md:inline">Limpar</span>
        <% end %>
      </div>
    <% end %>
  </section>

  <%= turbo_frame_tag "transactions" do %>
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
      <header class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
        <p class="font-semibold text-slate-900 dark:text-slate-100">Lista de transações</p>
        <span class="text-sm text-slate-500 dark:text-slate-400"><%= @transactions.size %> itens</span>
      </header>
      <% list_scroll_class = @transactions.size > 10 ? "max-h-[560px] overflow-y-auto" : "" %>
      <div class="<%= [list_scroll_class, 'md:hidden divide-y divide-slate-100 dark:divide-slate-800'].join(' ') %>">
        <% if @transactions.any? %>
          <%= render partial: "transactions/dashboard_transaction", collection: @transactions, as: :t %>
        <% else %>
          <div class="p-4">
            <%= render "shared/empty_alert",
                  title: "Nenhuma transação encontrada",
                  message: "Ajuste os filtros ou cadastre uma nova transação pelo menu \"Nova +\".",
                  tone: :info %>
          </div>
        <% end %>
      </div>
      <div class="<%= [list_scroll_class, 'hidden overflow-x-auto md:block'].join(' ') %>">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-300">
            <tr>
              <th class="px-4 py-3">Título</th>
              <th class="px-4 py-3">Tipo</th>
              <th class="px-4 py-3">Valor</th>
              <th class="px-4 py-3">Data</th>
              <th class="px-4 py-3">Categoria</th>
              <th class="px-4 py-3 text-right">Ações</th>
            </tr>
          </thead>
          <tbody id="transactions_list" class="divide-y divide-slate-100 bg-white dark:divide-slate-800 dark:bg-slate-900">
            <% if @transactions.any? %>
              <%= render @transactions %>
            <% else %>
              <tr>
                <td colspan="6" class="px-4 py-4">
                  <%= render "shared/empty_alert",
                        title: "Nenhuma transação encontrada",
                        message: "Ajuste os filtros ou cadastre uma nova transação pelo menu \"Nova +\".",
                        tone: :info %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
