<%= turbo_frame_tag "modal" do %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 pr-14 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Importar Extrato PDF</h2>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Importa despesas do cartão Banco do Brasil e preenche transações automaticamente.
      </p>
    </div>

    <% if flash.now[:alert].present? %>
      <div class="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-900/30 dark:text-red-200">
        <%= flash.now[:alert] %>
      </div>
    <% end %>

    <%= form_with url: create_statement_import_transactions_path, method: :post, data: { turbo_frame: "_top" }, multipart: true, class: "space-y-4" do %>
      <div class="space-y-1">
        <label class="text-sm font-medium text-slate-700 dark:text-slate-200">Arquivo PDF</label>
        <%= file_field_tag :statement_pdf, accept: "application/pdf", required: true, class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" %>
      </div>

      <div class="space-y-1">
        <label class="text-sm font-medium text-slate-700 dark:text-slate-200">Mês de referência da fatura</label>
        <%= month_field_tag :statement_reference_month, (@statement_reference_month || Date.current.beginning_of_month).strftime("%Y-%m"), required: true, class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" %>
      </div>

      <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
        <%= check_box_tag :delete_pdf_after_import, "1", true, class: "rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" %>
        Excluir PDF após importação
      </label>

      <div class="flex flex-col gap-2 sm:flex-row">
        <%= submit_tag "Importar extrato", class: "inline-flex justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700" %>
        <%= link_to "Cancelar", "#", data: { action: "modal#close" }, class: "inline-flex justify-center rounded-md bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" %>
      </div>
    <% end %>
  </section>
<% end %>
