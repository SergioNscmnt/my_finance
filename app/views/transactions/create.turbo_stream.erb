<%= turbo_stream.prepend "transactions_list" do %>
  <%= render @transaction %>
<% end %>

<%= turbo_stream.replace "dashboard_transactions" do %>
  <turbo-frame id="dashboard_transactions">
    <%= render "dashboard/transactions",
          transactions_grouped: @dashboard_transactions_grouped,
          list_label: @dashboard_transactions_label %>
  </turbo-frame>
<% end %>

<%= turbo_stream.replace "transaction_form" do %>
  <%= render "form", transaction: current_user.transactions.new, categories: current_user.categories.order(:name), frame_id: "transaction_form" %>
<% end %>

<%= turbo_stream.replace "dashboard-metrics" do %>
  <%= render "dashboard/metrics", data: @dashboard_data %>
<% end %>

<%= turbo_stream.replace "dashboard-charts" do %>
  <%= render "dashboard/charts", data: @dashboard_data %>
<% end %>

<%= turbo_stream.replace "dashboard-header" do %>
  <%= render "dashboard/header", data: @dashboard_data %>
<% end %>
