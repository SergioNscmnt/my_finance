#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

export DATABASE_NAME="${DATABASE_NAME:-my_finance_development}"
export DATABASE_NAME_TEST="${DATABASE_NAME_TEST:-my_finance_test}"
export MARIADB_ROOT_PASSWORD="${MARIADB_ROOT_PASSWORD:-rootpassword}"

compose_database_user="${COMPOSE_DATABASE_USER:-app}"
compose_database_password="${COMPOSE_DATABASE_PASSWORD:-password}"

if ! command -v docker >/dev/null 2>&1; then
  echo "Erro: comando docker não encontrado."
  echo "Instale o Docker ou use a alternativa sem Docker documentada no README."
  exit 1
fi

echo "==> Subindo MariaDB de teste/desenvolvimento via Docker Compose"
DATABASE_USER="$compose_database_user" \
DATABASE_PASSWORD="$compose_database_password" \
docker compose up -d db || {
  echo
  echo "Erro: não foi possível subir o MariaDB via Docker Compose."
  echo "Se estiver usando WSL, ative a integração da distro no Docker Desktop."
  echo "Depois execute novamente: bin/validate-local"
  exit 1
}

export DATABASE_HOST="${DATABASE_HOST:-127.0.0.1}"
export DATABASE_PORT="${DATABASE_PORT:-3307}"
export DATABASE_USER="${RAILS_DATABASE_USER:-root}"
export DATABASE_PASSWORD="${RAILS_DATABASE_PASSWORD:-$MARIADB_ROOT_PASSWORD}"

echo "==> Preparando banco de desenvolvimento"
bin/rails db:prepare

echo "==> Preparando banco de teste"
RAILS_ENV=test bin/rails db:prepare

echo "==> Executando testes"
bin/rails test "$@"
